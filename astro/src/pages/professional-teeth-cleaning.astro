---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import PageHero from "../components/PageHero.astro";
import ContactBand from "../components/ContactBand.astro";
import { liveAssets } from "../lib/data";

const cleaningOptions = [
  ["Professional cleaning", "Our hygienists remove tartar, plaque, and stains that a toothbrush can't reach, cleaning hard-to-reach areas, reducing harmful bacteria, and helping prevent gingivitis. A typical visit takes about an hour."],
  ["Dental sealants", "A protective coating applied to molars after a thorough cleaning, sealing off the pits where food and bacteria tend to collect. Sealants can protect a tooth from decay for up to 10 years."],
] as const;
---

<Layout title="Professional Teeth Cleaning | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow="Professional Teeth Cleaning"
        title="A fresh, healthy foundation for your smile."
        body="A thorough cleaning from our hygiene team, plus protective sealants when they help, on a schedule built around you."
        image={liveAssets.office}
      >
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact-us"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a cleaning</a>
          <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Ask a question</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="eyebrow">How often you'll need one</p>
            <h2 class="display-face mt-4 max-w-2xl text-4xl leading-[.98] tracking-[-.025em] text-[#2b2930] sm:text-5xl">A schedule built around your mouth.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[#596966]">Most patients should have their teeth cleaned every 3, 4, or 6 months — the right frequency depends on several factors, and your doctor and hygienist will help determine what's best for you. A cleaning brightens your smile while cutting the harmful bacteria that lead to gum and tooth disease.</p>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#f6d1bd]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">Book a cleaning.</p>
            <p class="mt-4 text-sm leading-7 text-[#d8e8e5]">Most visits take about an hour, start to finish.</p>
            <a href="/contact-us" class="action-button light mt-6 w-full">Request a visit <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="mt-14">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">What's included</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">Cleaning, and protection where it counts.</h3>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#596966]">Sealants are especially helpful for molars, where cavities are most common.</p>
          </div>
          <div class="service-option-grid mt-8">
            {cleaningOptions.map(([name, copy], index) => (
              <article class="service-option">
                <span class="service-option__number">0{index + 1}</span>
                <div>
                  <h4 class="display-face text-2xl leading-none text-[#2b2930]">{name}</h4>
                  <p class="mt-3 text-sm leading-6 text-[#596966]">{copy}</p>
                </div>
                <Icon name="lucide:check" class="service-option__check h-5 w-5" />
              </article>
            ))}
          </div>
        </section>

        <section class="related-services mt-16">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#27594e] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/preventative-dentistry" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Preventative Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">Thoughtful check-ups and cleaning for lasting oral health.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/cosmetic-dentistry" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Cosmetic Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">A personalized approach to a smile that feels like you.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title="A more confident smile starts with a conversation." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
