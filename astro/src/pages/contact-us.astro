---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import PageHero from "../components/PageHero.astro";
import { liveAssets } from "../lib/data";
---

<Layout title="Contact | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="contact" />
    <main>
      <PageHero
        eyebrow="Contact us"
        title="We'd love to hear from you."
        body="Call, send a note, or request a visit. Our team is here to answer questions and help you find a time that works for you."
        image={liveAssets.office}
      >
        <div class="mt-9 flex gap-3">
          <a class="action-button primary" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Call (520) 523-4860</a>
          <a class="action-button outline" href="mailto:checkin@brianmitchelldds.com">Send an email <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
        </div>
      </PageHero>
      <section class="mx-auto grid max-w-[1440px] gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[.95fr_1.05fr] lg:px-12 lg:py-28">
        <div class="relative overflow-hidden rounded-[1.5rem] bg-[#e0ece8] shadow-[0_20px_55px_rgba(33,67,59,.12)]">
          <iframe
            class="h-[560px] w-full"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Dr. Brian Mitchell & Associates location"
            src="https://www.google.com/maps?q=6383+E+Grant+Rd+Suite+155,+Tucson,+AZ+85715&output=embed"
          ></iframe>
          <div class="absolute bottom-5 left-5 bg-[#fffaf3] p-5 shadow-lg">
            <p class="eyebrow">Visit the practice</p>
            <p class="mt-2 text-sm font-extrabold leading-6 text-[#2b2930]">6383 E. Grant Road, Suite 155<br />Tucson, AZ 85715</p>
            <a href="https://maps.app.goo.gl/Fo6RRMdcgjxbApEWA" target="_blank" rel="noreferrer" class="mt-3 inline-flex items-center gap-1 text-xs font-extrabold uppercase tracking-[.1em] text-[#27594e] no-underline">Get directions <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" /></a>
          </div>
        </div>
        <div>
          <p class="eyebrow">Message us</p>
          <h2 class="display-face mt-4 text-4xl leading-none text-[#2b2930] sm:text-5xl">What can we help with?</h2>
          <p class="mt-5 max-w-lg text-sm leading-7 text-[#596966]">Share a few details and our team will be in touch. For privacy, please do not include sensitive health information in this form.</p>
          <form class="mt-8 grid gap-4">
            <label class="grid gap-2 text-[.66rem] font-extrabold uppercase tracking-[.12em] text-[#4a665f]">Name<input class="form-field" placeholder="Your name" /></label>
            <label class="grid gap-2 text-[.66rem] font-extrabold uppercase tracking-[.12em] text-[#4a665f]">Email<input class="form-field" type="email" placeholder="you@email.com" /></label>
            <label class="grid gap-2 text-[.66rem] font-extrabold uppercase tracking-[.12em] text-[#4a665f]">Phone<input class="form-field" type="tel" placeholder="(000) 000-0000" /></label>
            <label class="grid gap-2 text-[.66rem] font-extrabold uppercase tracking-[.12em] text-[#4a665f]">How can we help?<textarea class="form-field min-h-[132px] resize-y" placeholder="Tell us how we can help."></textarea></label>
            <button type="submit" class="action-button primary w-fit">Send message <Icon name="lucide:arrow-right" class="h-4 w-4" /></button>
          </form>
        </div>
      </section>
      <section class="bg-[#f7efe5]">
        <div class="mx-auto grid max-w-[1440px] gap-8 px-5 py-14 sm:px-8 md:grid-cols-3 lg:px-12">
          <div>
            <Icon name="lucide:clock-3" class="h-6 w-6 text-[#bb6846]" />
            <p class="mt-4 font-extrabold text-[#2b2930]">Office hours</p>
            <p class="mt-2 text-sm leading-7 text-[#596966]">Monday–Tuesday · 8am–4pm<br />Wednesday–Friday · 7am–4pm</p>
          </div>
          <div>
            <Icon name="lucide:phone" class="h-6 w-6 text-[#bb6846]" />
            <p class="mt-4 font-extrabold text-[#2b2930]">Same-day appointments</p>
            <p class="mt-2 text-sm leading-7 text-[#596966]">Call the practice to ask about today's availability.</p>
          </div>
          <div>
            <Icon name="lucide:sparkles" class="h-6 w-6 text-[#bb6846]" />
            <p class="mt-4 font-extrabold text-[#2b2930]">Payment options</p>
            <p class="mt-2 text-sm leading-7 text-[#596966]">PPO insurance, CareCredit&reg;, and our $650/year in-house savings plan. <a href="/financing" class="font-bold text-[#27594e] underline underline-offset-2">See financing options</a>.</p>
          </div>
        </div>
      </section>
    </main>
    <PracticeFooter />
  </div>
</Layout>

<script>
  const form = document.querySelector("form");
  form?.addEventListener("submit", (event) => event.preventDefault());
</script>
