---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PracticeHeader from "../../components/PracticeHeader.astro";
import PracticeFooter from "../../components/PracticeFooter.astro";
import PageHero from "../../components/PageHero.astro";
import ContactBand from "../../components/ContactBand.astro";
import { liveAssets, formCategories } from "../../lib/data";
---

<Layout title="Patient Forms | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="patient-info" />
    <main>
      <PageHero
        eyebrow="Patient forms"
        title="Handle the paperwork before you arrive."
        body="Complete your forms ahead of time and your first visit runs smoother from the moment you walk in."
        image={liveAssets.office}
        imagePosition="92% 65%"
      >
        <div class="mt-9 flex items-center gap-3 text-sm font-semibold text-[#354a4d]">
          <Icon name="lucide:clock-3" class="h-4 w-4" />
          Arrive 10 minutes early with your insurance card and photo ID
        </div>
      </PageHero>

      <section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
        <p class="eyebrow">Available forms</p>
        <h2 class="display-face mt-4 max-w-xl text-4xl leading-[.98] tracking-[-.025em] text-[#283e3c] sm:text-5xl">What you'll need, by visit type.</h2>
        <div class="mt-12 grid gap-7 lg:grid-cols-3">
          {formCategories.map((category) => (
            <article class="border-t-2 border-[#729f9a] bg-[#f0f5f4] p-7">
              <h3 class="display-face text-2xl leading-none text-[#283e3c]">{category.name}</h3>
              <ul class="mt-5 grid gap-3">
                {category.items.map((item) => (
                  <li class="text-sm leading-6 text-[#4a5a58]">
                    {item.file ? (
                      <a href={item.file} target="_blank" rel="noopener" class="group flex items-start gap-2 no-underline">
                        <Icon name="lucide:file-text" class="mt-0.5 h-4 w-4 flex-none text-[#3f6e69]" />
                        <span class="text-[#283e3c] underline decoration-[#729f9a] underline-offset-4 group-hover:decoration-[#283e3c]">{item.label}</span>
                        <span class="ml-auto pl-3 text-[.62rem] font-extrabold uppercase tracking-[.12em] text-[#3f6e69]">PDF</span>
                      </a>
                    ) : (
                      <span class="flex items-start gap-2">
                        <Icon name="lucide:file-text" class="mt-0.5 h-4 w-4 flex-none text-[#3f6e69]" />
                        <span>{item.label} <span class="text-[#6f807c]">· provided at the practice</span></span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="mt-14 max-w-2xl border-t border-[#729f9a]/25 pt-10">
          <p class="eyebrow">How to submit</p>
          <h2 class="display-face mt-4 text-3xl leading-none text-[#283e3c] sm:text-4xl">Bring them in, or send them ahead.</h2>
          <p class="mt-5 text-base leading-8 text-[#4a5a58]">Download the forms above, print and complete them, then bring them to your visit or send them ahead by fax or email. If you are unsure which forms you need, call the practice and our team will point you to the right ones.</p>
          <div class="mt-6 grid gap-2 text-sm text-[#4a5a58]">
            <p><strong class="text-[#283e3c]">Fax:</strong> (520) 881-3759</p>
            <p><strong class="text-[#283e3c]">Email:</strong> tucsonsmileteam@gmail.com</p>
          </div>
          <a class="action-button dark mt-7" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Call (520) 523-4860</a>
        </div>
      </section>

      <ContactBand title="Ready to schedule your visit?" />
    </main>
    <PracticeFooter />
  </div>
</Layout>
