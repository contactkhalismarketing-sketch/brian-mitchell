---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PracticeHeader from "../../components/PracticeHeader.astro";
import PracticeFooter from "../../components/PracticeFooter.astro";
import PageHero from "../../components/PageHero.astro";
import ContactBand from "../../components/ContactBand.astro";
import { serviceHeroes } from "../../lib/data";
import { posts, formatPostDate } from "../../lib/posts";

const [featured, ...rest] = posts;
---

<Layout title="Patient Information | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="blogs" />
    <main>
      <PageHero
        eyebrow="Patient information"
        title="A closer look at your care."
        body="Clear information can make a dental decision feel easier. Explore clinical insight, treatment context, and patient education from Dr. Brian Mitchell & Associates."
        image={serviceHeroes.blogs.image}
        imagePosition={serviceHeroes.blogs.position}
        imageMobile={serviceHeroes.blogs.mobile}
      >
        <div class="mt-9 flex flex-wrap gap-3">
          <span class="stamp">Dental implants</span>
          <span class="stamp">Orthodontics</span>
          <span class="stamp">Restorative dentistry</span>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
        <div class="grid gap-8 border-b border-[#e2ca9f]/25 pb-12 lg:grid-cols-[1.2fr_.8fr] lg:items-center">
          <a href={`/${featured.slug}/`} class="block">
            <Image src={featured.hero} alt={featured.heroAlt} style={{ objectPosition: featured.heroPosition ?? "center" }} class="aspect-[16/9] w-full object-cover" width={800} loading="eager" />
          </a>
          <article>
            <p class="eyebrow">Featured article · {featured.category}</p>
            <h2 class="display-face mt-4 text-4xl leading-[.98] tracking-[-.025em] text-[#082824] sm:text-5xl">{featured.title}</h2>
            <p class="mt-5 text-sm leading-7 text-[#55635f]">{featured.excerpt}</p>
            <p class="mt-4 text-xs font-bold text-[#6f807c]">{formatPostDate(featured.date)}</p>
            <a href={`/${featured.slug}/`} class="action-button dark mt-7">Read the article <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </article>
        </div>
        <div class="mt-14 grid gap-7 md:grid-cols-2 xl:grid-cols-3">
          {rest.map((post) => (
            <a href={`/${post.slug}/`} class="service-card group block no-underline">
              <div class="service-card__media">
                <Image src={post.hero} alt={post.heroAlt} style={{ objectPosition: post.heroPosition ?? "center" }} width={640} />
              </div>
              <div class="service-card__body flex flex-1 flex-col">
                <p class="eyebrow">{post.category}</p>
                <h3 class="display-face mt-3 text-2xl leading-tight text-[#082824]">{post.title}</h3>
                <p class="mt-3 text-sm leading-6 text-[#55635f]">{post.excerpt}</p>
                <div class="mt-auto flex items-center justify-between gap-3 pt-6">
                  <span class="text-xs font-bold text-[#4f5f5c]">{formatPostDate(post.date)}</span>
                  <span class="service-arrow flex-none"><Icon name="lucide:arrow-right" class="h-4 w-4" /></span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
      <ContactBand title="Have a question about a treatment?" />
    </main>
    <PracticeFooter />
  </div>
</Layout>
