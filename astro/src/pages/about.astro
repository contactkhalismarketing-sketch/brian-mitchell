---
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import PageHero from "../components/PageHero.astro";
import ContactBand from "../components/ContactBand.astro";
import PracticeTourPanel from "../components/PracticeTourPanel.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { liveAssets, team, doctors } from "../lib/data";
---

<Layout title="About | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="about" />
    <main>
      <PageHero
        eyebrow="About the practice"
        title="Personal care, in a place that feels considered."
        body="Driven by a commitment to cultivating strong, healthy, and aesthetically pleasing smiles, our team welcomes you into a serene environment where your comfort and goals come first."
        image={liveAssets.team}
        imagePosition="50% 0%"
        taller
      >
        <div class="mt-9">
          <a class="action-button primary" href="#team"><Icon name="lucide:users" class="h-4 w-4" />Meet the team</a>
        </div>
      </PageHero>
      <section class="mx-auto grid max-w-[1440px] gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[.9fr_1.1fr] lg:px-12 lg:py-28">
        <div>
          <p class="eyebrow">What sets us apart?</p>
          <h2 class="display-face mt-4 max-w-xl text-4xl leading-[.98] tracking-[-.025em] text-[#283e3c] sm:text-5xl">A sophisticated approach to care.</h2>
        </div>
        <div class="space-y-6 text-base leading-8 text-[#4a5a58]">
          <p>We go beyond routine dental care by providing personalised services designed around your individual needs. Our goal is to give you a clear understanding of your options and an experience that feels calm from the moment you arrive.</p>
          <p>Alongside the essentials of a healthy smile, we understand the value of preserving and improving its natural beauty. It is a careful balance of clinical expertise, modern technology, and attention to the person in the chair.</p>
        </div>
      </section>
      <PracticeTourPanel />
      <section class="bg-[#f0f5f4]">
        <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
          <p class="eyebrow">Meet the doctors</p>
          <div class="mt-8 grid gap-7">
            {doctors.map((doctor) => (
              <article class="grid overflow-hidden bg-[#ffffff] shadow-[0_20px_46px_rgba(40,62,60,.09)] sm:grid-cols-[.7fr_1.3fr] lg:grid-cols-[.45fr_1.55fr] doctor-feature">
                <Image src={doctor.image} alt={doctor.name} class="h-full min-h-[360px] w-full object-cover object-top" width={900} />
                <div class="doctor-feature__content p-8">
                  <p class="eyebrow">{doctor.name} · {doctor.role}</p>
                  <h3 class="display-face mt-3 text-3xl leading-none text-[#283e3c]">{doctor.heading}</h3>
                  <p class="mt-5 text-sm leading-7 text-[#4a5a58]">{doctor.bio}</p>
                  <a href="/contact/" class="action-button primary mt-7">Book an appointment <Icon name="lucide:calendar-days" class="h-4 w-4" /></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section id="team" class="team-section relative scroll-mt-6 overflow-hidden">
        <div class="relative mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="eyebrow">Meet the team</p>
              <h2 class="display-face mt-4 text-4xl leading-none text-[#283e3c] sm:text-5xl">The people who make you feel at home.</h2>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#4a5a58]">The same welcoming team supports every step—from your first call through treatment and ongoing care.</p>
          </div>
          <figure class="relative mx-auto mt-12 max-w-[1100px]">
            <div class="absolute -left-3 -top-3 hidden h-full w-full border border-[#5f8f8a]/55 sm:block" aria-hidden="true"></div>
            <Image src={liveAssets.team} alt="The Dr. Brian Mitchell & Associates team outside the practice at 6383 E. Grant Road" class="relative aspect-[16/10] w-full object-cover object-[50%_62%]" width={1100} loading="lazy" />
            <figcaption class="hero-media-label">Our Team</figcaption>
          </figure>
          <div class="team-grid mt-14">
            {team.map((member, index) => (
              <article class={`team-card team-card-${index + 1}`}>
                {member.image ? (
                  <Image src={member.image} alt={member.name} width={320} />
                ) : (
                  <div class="team-card__placeholder" aria-label={`${member.name} photo coming soon`}><span>{member.name[0]}</span></div>
                )}
                <div>
                  <h3 class="display-face text-3xl leading-none text-[#283e3c]">{member.name}</h3>
                  <p class="mt-2 text-[.66rem] font-extrabold uppercase tracking-[.12em] text-[#354a4d]">{member.role}</p>
                  <p class="team-bio mt-5">{member.bio}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
      <ContactBand title="The right care starts with the right conversation." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
