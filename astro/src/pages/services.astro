---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import PageHero from "../components/PageHero.astro";
import ContactBand from "../components/ContactBand.astro";
import FullServiceDirectory from "../components/FullServiceDirectory.astro";
import { serviceHeroes, serviceList } from "../lib/data";
---

<Layout title="Services | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow="Services"
        title="Care made personal."
        body="Welcome to our dental family. Our team makes your dental journey as comfortable as possible, with a thoughtful plan for the smile you have today and the one you're working toward."
        image={serviceHeroes.routine.image}
        imagePosition={serviceHeroes.routine.position}
        imageMobile={serviceHeroes.routine.mobile}
      >
        <div class="mt-9 flex flex-wrap gap-3">
          <span class="stamp">Cosmetic dentistry</span>
          <span class="stamp">Orthodontics</span>
          <span class="stamp">Dental implants</span>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
        <div class="grid gap-9 lg:grid-cols-[.9fr_1.1fr] lg:items-end">
          <div>
            <p class="eyebrow">How we can help</p>
            <h2 class="display-face mt-4 max-w-xl text-4xl leading-[.98] tracking-[-.025em] text-[#1f2b33] sm:text-5xl">Thoughtful treatment. Clear next steps.</h2>
          </div>
          <p class="max-w-xl text-sm leading-7 text-[#4d6270]">From routine preventive care to restorative and aesthetic treatment, we begin by understanding your needs and then talk through the options together. New here? <a href="/first-visit/" class="font-bold text-[#1d5f73] underline underline-offset-2">See exactly what to expect at your first visit</a>.</p>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {serviceList.map(([name, copy, image, href], index) => (
            <a href={href} class="service-card group block no-underline">
              <div class="service-card__media">
                <Image src={image} alt="" width={640} />
              </div>
              <div class="service-card__body">
                <p class="text-[.62rem] font-extrabold uppercase tracking-[.15em] text-[#8c6a30]">0{index + 1} · Explore care</p>
                <div class="mt-3 flex items-end justify-between gap-3">
                  <div>
                    <h3 class="display-face text-3xl leading-none text-[#1f2b33]">{name}</h3>
                    <p class="mt-3 max-w-[240px] text-sm leading-6 text-[#4d6270]">{copy}</p>
                  </div>
                  <span class="service-arrow flex-none"><Icon name="lucide:arrow-right" class="h-4 w-4" /></span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <FullServiceDirectory />
      </section>
      <ContactBand title="Questions about a treatment? Let's talk." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
