---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PracticeHeader from "../../components/PracticeHeader.astro";
import PracticeFooter from "../../components/PracticeFooter.astro";
import PageHero from "../../components/PageHero.astro";
import ContactBand from "../../components/ContactBand.astro";
import { serviceHeroes } from "../../lib/data";

const preventativeCare = [
  ["Comprehensive exam", "We check for decay, gum and periodontal disease, oral cancer, and TMJ issues, and screen for receding gums, erupting wisdom teeth, or cavities."],
  ["Digital X-rays", "When needed, X-rays help us spot problems in the gum, bone, or roots of a tooth well before they become bigger issues."],
  ["Professional cleaning", "Our hygiene team finishes each visit with a thorough cleaning, so you leave with a healthier, more confident smile."],
] as const;
---

<Layout title="Preventative Dentistry | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow="Preventative Dentistry"
        title="The exam that catches things early."
        body="A thorough check of your teeth, gums, and bite, designed to catch problems while they're still simple to treat."
        image={serviceHeroes.preventative.image}
        imagePosition={serviceHeroes.preventative.position}
        imageMobile={serviceHeroes.preventative.mobile}
      >
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a visit</a>
          <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Ask a question</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="eyebrow">The next level of routine care</p>
            <h2 class="display-face mt-4 max-w-2xl text-4xl leading-[.98] tracking-[-.025em] text-[#1f2b33] sm:text-5xl">A personalized approach to prevention.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[#4d6270]">Preventative visits go beyond a basic check-up. We combine a comprehensive oral health assessment with an honest conversation about your smile, so small issues get caught early and your care stays proactive, not reactive.</p>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#ecd9ad]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">A preventative visit.</p>
            <p class="mt-4 text-sm leading-7 text-[#cfe5ee]">Same-day appointments are available if it's been a while since your last check-up.</p>
            <a href="/contact/" class="action-button light mt-6 w-full">Request a visit <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="mt-14">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">What's included</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#1f2b33] sm:text-4xl">Every visit, covered from every angle.</h3>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#4d6270]">A complete look at your oral health, paired with a cleaning from our hygiene team.</p>
          </div>
          <div class="service-option-grid mt-8">
            {preventativeCare.map(([name, copy], index) => (
              <article class="service-option">
                <span class="service-option__number">0{index + 1}</span>
                <div>
                  <h4 class="display-face text-2xl leading-none text-[#1f2b33]">{name}</h4>
                  <p class="mt-3 text-sm leading-6 text-[#4d6270]">{copy}</p>
                </div>
                <Icon name="lucide:check" class="service-option__check h-5 w-5" />
              </article>
            ))}
          </div>
        </section>

        <section class="related-services mt-16">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#1f2b33] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services/" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#1d5f73] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/service/professional-teeth-cleaning/" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#1f2b33]">Professional Teeth Cleaning</span>
                <span class="mt-2 block text-sm leading-6 text-[#4d6270]">A fresh, healthy foundation for your ongoing care.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/first-visit/" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#1f2b33]">Your First Visit</span>
                <span class="mt-2 block text-sm leading-6 text-[#4d6270]">Know exactly what to expect before you arrive.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/bioclear/" class="related-service-link">
              <span class="related-service-link__number">03</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#1f2b33]">Bioclear</span>
                <span class="mt-2 block text-sm leading-6 text-[#4d6270]">Conservative, aesthetic solutions for natural teeth.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title="A more confident smile starts with a conversation." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
