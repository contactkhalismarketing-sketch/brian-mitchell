---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PracticeHeader from "../../components/PracticeHeader.astro";
import PracticeFooter from "../../components/PracticeFooter.astro";
import PageHero from "../../components/PageHero.astro";
import ContactBand from "../../components/ContactBand.astro";
import SectionHead from "../../components/content/SectionHead.astro";
import CardGrid from "../../components/content/CardGrid.astro";
import LeadList from "../../components/content/LeadList.astro";
import StepList from "../../components/content/StepList.astro";
import CompareTable from "../../components/content/CompareTable.astro";
import FaqList from "../../components/content/FaqList.astro";
import PorcelainVideoPanel from "../../components/PorcelainVideoPanel.astro";
import { serviceHeroes } from "../../lib/data";
import * as c from "../../content-pages/cosmetic-dentistry";
---

<Layout title={c.meta.title} description={c.meta.description}>
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow={c.hero.eyebrow}
        title={c.hero.title}
        subtitle={c.hero.subtitle}
        image={serviceHeroes.cosmetic.image}
        imageAlt={serviceHeroes.cosmetic.alt}
        imagePosition={serviceHeroes.cosmetic.position}
        imageMobile={serviceHeroes.cosmetic.mobile}
      >
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a Smile Consultation</a>
          <a class="action-button outline" href="tel:5208816767"><Icon name="lucide:phone" class="h-4 w-4" />Call (520) 881-6767</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="max-w-2xl text-base leading-8 text-[#4a5a58] sm:text-[1.075rem] sm:leading-9" set:html={c.intro} />
            <ul class="content-trust">
              {c.trust.map((item) => <li><Icon name="lucide:check" class="h-4 w-4" />{item}</li>)}
            </ul>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#d5e4e2]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">A smile consultation.</p>
            <p class="mt-4 text-sm leading-7 text-[#d5e4e2]">Bring your questions. We will help you understand what is possible and what is appropriate for your smile.</p>
            <a href="/contact/" class="action-button light mt-6 w-full">Request a consultation <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="content-section">
          <SectionHead title="Common Smile Concerns We Fix" />
          <CardGrid items={c.concerns} />
        </section>

        <section class="content-section">
          <SectionHead title="Cosmetic Dentistry Options in Tucson" />
          <CardGrid items={c.options} />
        </section>

        <section class="content-section">
          <SectionHead title="Which Cosmetic Treatment Is Right for You?" intro={c.matchIntro} />
          <CompareTable caption="Common smile concerns and the cosmetic options that suit them" columns={c.comparison.columns} rows={c.comparison.rows} />
        </section>

        <section class="content-section">
          <SectionHead title="What to Expect at Your Smile Consultation" />
          <StepList items={c.steps} />
        </section>

        <section class="content-section grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-stretch">
          <article class="service-copy-panel">
            <p class="eyebrow">Watch Dr. Mitchell</p>
            <h2 class="display-face mt-3 text-4xl leading-none text-white">A closer look at cosmetic care.</h2>
            <p class="mt-6 text-base leading-8 text-[#d5e4e2]">Porcelain veneers are delicate facings applied to the front teeth. In the right situation, they can help refine shape, shade, or small imperfections while preserving a natural appearance.</p>
            <div class="mt-7 border-t border-white/15 pt-6">
              <p class="text-sm font-extrabold text-white">Your consultation includes</p>
              <p class="mt-2 text-sm leading-7 text-[#d5e4e2]">Time to understand your goals, discuss what is clinically appropriate, and review your options together.</p>
            </div>
          </article>
          <PorcelainVideoPanel />
        </section>

        <section class="content-section">
          <SectionHead title="Cosmetic Dentistry Cost and Payment Options" intro={c.costIntro} />
          <LeadList items={c.cost} columns={3} />
        </section>

        <section class="content-section">
          <SectionHead title="Why Choose Dr. Mitchell for Cosmetic Dentistry in Tucson?" />
          <LeadList items={c.why} columns={3} />
        </section>

        <section class="content-section faq-section">
          <SectionHead title="Cosmetic Dentistry FAQs" />
          <FaqList items={c.faqs} />
        </section>

        <section class="related-services content-section">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#283e3c] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services/" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#354a4d] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/service/dental-implants/" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#283e3c]">Dental Implants</span>
                <span class="mt-2 block text-sm leading-6 text-[#4a5a58]">Replace missing teeth with care that supports comfort, function, and confidence.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/orthodontics/" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#283e3c]">Orthodontics</span>
                <span class="mt-2 block text-sm leading-6 text-[#4a5a58]">Explore clear, thoughtful options to bring alignment into focus.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/preventative-dentistry/" class="related-service-link">
              <span class="related-service-link__number">03</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#283e3c]">Preventative Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#4a5a58]">Build a healthy foundation with consistent, patient-first care.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title={c.closing.title} text={c.closing.text} />
    </main>
    <PracticeFooter />
  </div>
</Layout>
