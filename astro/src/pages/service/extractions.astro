---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PracticeHeader from "../../components/PracticeHeader.astro";
import PracticeFooter from "../../components/PracticeFooter.astro";
import PageHero from "../../components/PageHero.astro";
import ContactBand from "../../components/ContactBand.astro";
import { serviceHeroes } from "../../lib/data";

const extractionCare = [
  ["During your visit", "We numb the area thoroughly before starting, and monitor you closely throughout the procedure."],
  ["The first hour", "Sterile gauze is placed over the site to support clotting — plan to keep it in place for about an hour."],
  ["The next 48 hours", "Expect some swelling over the next few days, managed with ice packs and any medication prescribed. Avoid smoking, alcohol, straws, rinsing, and strenuous activity during this window."],
] as const;
---

<Layout title="Tooth Extractions | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow="Extractions"
        title="Removed only when it's truly the best option."
        body="Preserving your natural teeth is always our priority. An extraction is considered only when it's the clearest path to protecting your health."
        image={serviceHeroes.extractions.image}
        imagePosition={serviceHeroes.extractions.position}
        imageMobile={serviceHeroes.extractions.mobile}
      >
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a consultation</a>
          <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Ask a question</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="eyebrow">When it's the right call</p>
            <h2 class="display-face mt-4 max-w-2xl text-4xl leading-[.98] tracking-[-.025em] text-[#082824] sm:text-5xl">Three reasons we'd recommend removal.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[#55635f]">A tooth may need to come out when decay or injury has left it beyond repair, when there isn't enough room in your mouth for it, or when a severe infection is present in the tooth, gum, or bone. In each case, removal can relieve pain, stop decay from spreading, and help prevent gum disease.</p>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#e2ca9f]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">A same-day visit.</p>
            <p class="mt-4 text-sm leading-7 text-[#e2ca9f]">If a tooth is causing pain, call us. Same-day appointments are available.</p>
            <a href="/contact/" class="action-button light mt-6 w-full">Request a visit <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="mt-14">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">What to expect</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#082824] sm:text-4xl">Care during and after.</h3>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#55635f]">Some discomfort during the procedure is normal — our team keeps a close eye on you throughout.</p>
          </div>
          <div class="service-option-grid mt-8">
            {extractionCare.map(([name, copy], index) => (
              <article class="service-option">
                <span class="service-option__number">0{index + 1}</span>
                <div>
                  <h4 class="display-face text-2xl leading-none text-[#082824]">{name}</h4>
                  <p class="mt-3 text-sm leading-6 text-[#55635f]">{copy}</p>
                </div>
                <Icon name="lucide:check" class="service-option__check h-5 w-5" />
              </article>
            ))}
          </div>
        </section>

        <section class="related-services mt-16">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#082824] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services/" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#354d49] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/service/dental-implants/" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#082824]">Dental Implants</span>
                <span class="mt-2 block text-sm leading-6 text-[#55635f]">Replace missing teeth with care that supports comfort, function, and confidence.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/root-canals/" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#082824]">Root Canals</span>
                <span class="mt-2 block text-sm leading-6 text-[#55635f]">A precise way to clear infection and save a tooth when we can.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/bridges/" class="related-service-link">
              <span class="related-service-link__number">03</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#082824]">Bridges</span>
                <span class="mt-2 block text-sm leading-6 text-[#55635f]">Restorative options designed to renew everyday confidence.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title="A more confident smile starts with a conversation." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
