---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PracticeHeader from "../../components/PracticeHeader.astro";
import PracticeFooter from "../../components/PracticeFooter.astro";
import PageHero from "../../components/PageHero.astro";
import ContactBand from "../../components/ContactBand.astro";
import { serviceHeroes } from "../../lib/data";

const bridgeSteps = [
  ["Reshaping", "The teeth on either side of the gap are gently reshaped to support the bridge."],
  ["Impression", "A mold captures the contours around your missing tooth and is sent to the dental lab."],
  ["Temporary bridge", "You wear a temporary bridge while your permanent one is custom made."],
  ["Permanent placement", "Your finished bridge is fitted and permanently affixed with dental adhesive."],
] as const;
---

<Layout title="Dental Bridges | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow="Bridges"
        title="A fixed way to fill the gap."
        body="Dental bridges use your existing teeth as anchors for an artificial tooth, restoring your bite and your smile without a removable appliance."
        image={serviceHeroes.bridges.image}
        imagePosition={serviceHeroes.bridges.position}
        imageMobile={serviceHeroes.bridges.mobile}
      >
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a consultation</a>
          <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Ask a question</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="eyebrow">Built on the teeth you already have</p>
            <h2 class="display-face mt-4 max-w-2xl text-4xl leading-[.98] tracking-[-.025em] text-[#082824] sm:text-5xl">A cost-effective way to close a gap.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[#55635f]">A bridge anchors an artificial tooth to your adjacent natural teeth, using materials like gold, metal alloys, or porcelain for strength and durability. Left unaddressed, a missing tooth can let surrounding teeth shift out of place and make everyday eating and speaking harder — a bridge helps keep everything where it belongs.</p>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#e2ca9f]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">A bridge consultation.</p>
            <p class="mt-4 text-sm leading-7 text-[#e2ca9f]">We will look at the gap together and talk through whether a bridge or another option fits best.</p>
            <a href="/contact/" class="action-button light mt-6 w-full">Request a consultation <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="mt-14">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">How it works</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#082824] sm:text-4xl">From impression to a finished bridge.</h3>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#55635f]">A temporary bridge keeps you comfortable while your permanent one is custom made.</p>
          </div>
          <div class="service-option-grid mt-8">
            {bridgeSteps.map(([name, copy], index) => (
              <article class="service-option">
                <span class="service-option__number">0{index + 1}</span>
                <div>
                  <h4 class="display-face text-2xl leading-none text-[#082824]">{name}</h4>
                  <p class="mt-3 text-sm leading-6 text-[#55635f]">{copy}</p>
                </div>
                <Icon name="lucide:check" class="service-option__check h-5 w-5" />
              </article>
            ))}
          </div>
        </section>

        <section class="related-services mt-16">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#082824] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services/" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#354d49] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/service/dental-implants/" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#082824]">Dental Implants</span>
                <span class="mt-2 block text-sm leading-6 text-[#55635f]">Replace missing teeth with care that supports comfort, function, and confidence.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/root-canals/" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#082824]">Root Canals</span>
                <span class="mt-2 block text-sm leading-6 text-[#55635f]">Comfort-led treatment to protect and preserve your natural tooth.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/extractions/" class="related-service-link">
              <span class="related-service-link__number">03</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#082824]">Extractions</span>
                <span class="mt-2 block text-sm leading-6 text-[#55635f]">Clear guidance and gentle care when a tooth needs attention.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title="A more confident smile starts with a conversation." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
