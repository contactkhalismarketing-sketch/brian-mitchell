---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PracticeHeader from "../../components/PracticeHeader.astro";
import PracticeFooter from "../../components/PracticeFooter.astro";
import PageHero from "../../components/PageHero.astro";
import ContactBand from "../../components/ContactBand.astro";
import { serviceHeroes } from "../../lib/data";

const orthodonticsOptions = [
  ["Traditional orthodontics", "The gold standard for teeth straightening and bite correction, now available with nearly invisible tooth-colored brackets alongside classic metal options."],
  ["Invisalign", "A clear, removable tray designed to gradually straighten your teeth. Trays come out for brushing, flossing, and meals, so oral hygiene stays simple."],
] as const;
---

<Layout title="Orthodontics | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow="Orthodontics"
        title="Straighter teeth, at your pace."
        body="A personalized path to a straighter smile and a better bite, with traditional and Invisalign options for patients of every age."
        image={serviceHeroes.orthodontics.image}
        imagePosition={serviceHeroes.orthodontics.position}
        imageMobile={serviceHeroes.orthodontics.mobile}
      >
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a consultation</a>
          <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Ask a question</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="eyebrow">Smiles and healthy bites</p>
            <h2 class="display-face mt-4 max-w-2xl text-4xl leading-[.98] tracking-[-.025em] text-[#082824] sm:text-5xl">Two paths to a straighter smile.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[#55635f]">Whether you prefer the proven results of traditional braces or the discretion of clear aligners, your plan is built around your teeth, your bite, and your day-to-day life. We treat teens and adults alike.</p>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#e2ca9f]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">An orthodontic consultation.</p>
            <p class="mt-4 text-sm leading-7 text-[#e2ca9f]">We will look at your bite and alignment together and talk through which option fits your goals and timeline.</p>
            <a href="/contact/" class="action-button light mt-6 w-full">Request a consultation <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="mt-14">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Explore your options</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#082824] sm:text-4xl">Two ways to get there.</h3>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#55635f]">Your treatment plan is always tailored to your bite, your priorities, and your timeline.</p>
          </div>
          <div class="service-option-grid mt-8">
            {orthodonticsOptions.map(([name, copy], index) => (
              <article class="service-option">
                <span class="service-option__number">0{index + 1}</span>
                <div>
                  <h4 class="display-face text-2xl leading-none text-[#082824]">{name}</h4>
                  <p class="mt-3 text-sm leading-6 text-[#55635f]">{copy}</p>
                </div>
                <Icon name="lucide:check" class="service-option__check h-5 w-5" />
              </article>
            ))}
          </div>
        </section>

        <section class="related-services mt-16">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#082824] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services/" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#354d49] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/service/dental-implants/" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#082824]">Dental Implants</span>
                <span class="mt-2 block text-sm leading-6 text-[#55635f]">Replace missing teeth with care that supports comfort, function, and confidence.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/cosmetic-dentistry/" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#082824]">Cosmetic Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#55635f]">A personalized approach to a smile that feels like you.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/adult-braces/" class="related-service-link">
              <span class="related-service-link__number">03</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#082824]">Adult Braces</span>
                <span class="mt-2 block text-sm leading-6 text-[#55635f]">A considered path toward better alignment at any stage of life.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title="A more confident bite starts with a conversation." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
