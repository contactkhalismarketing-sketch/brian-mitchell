---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PracticeHeader from "../../components/PracticeHeader.astro";
import PracticeFooter from "../../components/PracticeFooter.astro";
import PageHero from "../../components/PageHero.astro";
import ContactBand from "../../components/ContactBand.astro";
import SectionHead from "../../components/content/SectionHead.astro";
import CardGrid from "../../components/content/CardGrid.astro";
import LeadList from "../../components/content/LeadList.astro";
import StepList from "../../components/content/StepList.astro";
import CompareTable from "../../components/content/CompareTable.astro";
import FaqList from "../../components/content/FaqList.astro";
import FeatureBlock from "../../components/content/FeatureBlock.astro";
import { serviceHeroes } from "../../lib/data";
import * as c from "../../content-pages/orthodontics";
---

<Layout title={c.meta.title} description={c.meta.description}>
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow={c.hero.eyebrow}
        title={c.hero.title}
        subtitle={c.hero.subtitle}
        image={serviceHeroes.orthodontics.image}
        imageAlt={serviceHeroes.orthodontics.alt}
        imagePosition={serviceHeroes.orthodontics.position}
        imageMobile={serviceHeroes.orthodontics.mobile}
      >
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book My Free Invisalign Consult</a>
          <a class="action-button outline" href="tel:5208816767"><Icon name="lucide:phone" class="h-4 w-4" />Call (520) 881-6767</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="max-w-2xl text-base leading-8 text-[#4a5a58] sm:text-[1.075rem] sm:leading-9" set:html={c.intro} />
            <ul class="content-trust">
              {c.trust.map((item) => <li><Icon name="lucide:check" class="h-4 w-4" />{item}</li>)}
            </ul>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#d5e4e2]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">An orthodontic consultation.</p>
            <p class="mt-4 text-sm leading-7 text-[#d5e4e2]">We will look at your bite and alignment together and talk through which option fits your goals and timeline.</p>
            <a href="/contact/" class="action-button light mt-6 w-full">Request a consultation <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="content-section">
          <SectionHead title="Alignment Problems We Treat" />
          <CardGrid items={c.problems} />
        </section>

        <section class="content-section">
          <SectionHead title="Invisalign in Tucson" intro={c.invisalignIntro} />
          <LeadList items={c.invisalignPoints} columns={2} />
          <div class="content-prose mt-6"><p>{c.invisalignWear}</p></div>
          <div class="mt-8"><CardGrid items={c.invisalignExtras} columns={2} /></div>
        </section>

        <section class="content-section">
          <FeatureBlock eyebrow="Braces" title="Traditional Braces with Tooth-Colored Brackets" html={c.braces} />
        </section>

        <section class="content-section">
          <SectionHead title="Invisalign vs. Braces: Which Is Right for You?" intro={c.comparisonIntro} />
          <CompareTable caption="Invisalign and traditional braces compared" columns={c.comparison.columns} rows={c.comparison.rows} />
        </section>

        <section class="content-section">
          <FeatureBlock dark eyebrow="One office" title="The Benefit of Orthodontics at Your Family Dental Office" html={c.familyOffice} />
        </section>

        <section class="content-section">
          <SectionHead title="What to Expect" />
          <StepList items={c.steps} />
        </section>

        <section class="content-section">
          <SectionHead title="Invisalign Cost in Tucson" intro={c.costIntro} />
          <LeadList items={c.cost} columns={3} />
        </section>

        <section class="content-section">
          <SectionHead title="Why Choose Dr. Mitchell for Invisalign in Tucson?" />
          <LeadList items={c.why} columns={3} />
        </section>

        <section class="content-section faq-section">
          <SectionHead title="Invisalign FAQs" />
          <FaqList items={c.faqs} />
        </section>

        <section class="related-services content-section">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#283e3c] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services/" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#354a4d] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/service/dental-implants/" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#283e3c]">Dental Implants</span>
                <span class="mt-2 block text-sm leading-6 text-[#4a5a58]">Replace missing teeth with care that supports comfort, function, and confidence.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/cosmetic-dentistry/" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#283e3c]">Cosmetic Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#4a5a58]">A personalized approach to a smile that feels like you.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/adult-braces/" class="related-service-link">
              <span class="related-service-link__number">03</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#283e3c]">Adult Braces</span>
                <span class="mt-2 block text-sm leading-6 text-[#4a5a58]">A considered path toward better alignment at any stage of life.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title={c.closing.title} text={c.closing.text} />
    </main>
    <PracticeFooter />
  </div>
</Layout>
