---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import PageHero from "../components/PageHero.astro";
import ContactBand from "../components/ContactBand.astro";
import { liveAssets, specials, practiceStats } from "../lib/data";
import ReviewSlider from "../components/ReviewSlider.astro";
import StarIcon from "../components/StarIcon.astro";
---

<Layout title="New Patient Specials | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="new" />
    <main>
      <PageHero
        eyebrow="New patients"
        title="A clearer next step starts here."
        body="Real offers, real pricing, and a team with decades of combined experience — so you know exactly what to expect before you book."
        image={liveAssets.office}
      >
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact-us"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book an appointment</a>
          <a class="action-button light" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Call (520) 523-4860</a>
        </div>
      </PageHero>

      <section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
        <p class="eyebrow">Current specials</p>
        <h2 class="display-face mt-4 max-w-xl text-4xl leading-[.98] tracking-[-.025em] text-[#2b2930] sm:text-5xl">Straightforward pricing, no surprises.</h2>
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {specials.map((special) => (
            <article class="border border-[#77a49f]/25 bg-[#fffaf3] p-7">
              <p class="eyebrow">{special.name}</p>
              <p class="display-face mt-3 text-3xl leading-none text-[#2b2930]">{special.price}</p>
              <p class="mt-4 text-sm leading-7 text-[#596966]">{special.detail}</p>
            </article>
          ))}
        </div>
        <p class="mt-8 max-w-2xl text-sm leading-7 text-[#596966]">Have questions about what's included, or want to know if a special fits your situation? Call the practice and our team will walk through it with you before you book anything.</p>
        <div class="mt-8">
          <a href="/financing" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#27594e] no-underline">See all financing & insurance options <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
        </div>
      </section>

      <section class="bg-[#2b2930] text-white">
        <div class="mx-auto max-w-[1440px] px-5 py-16 text-center sm:px-8 lg:px-12 lg:py-20">
          <p class="eyebrow text-[#bde0da]">Why patients trust this team</p>
          <p class="display-face mt-4 text-5xl leading-none">{practiceStats.combinedExperience}</p>
          <p class="mt-2 text-sm leading-7 text-[#d8e8e5]">of combined experience across the team caring for you.</p>
          <div class="mt-8 flex items-center justify-center gap-3">
            <div class="flex gap-1">
              {[0, 1, 2, 3, 4].map(() => <StarIcon class="h-4 w-4 text-[#df8b64]" />)}
            </div>
            <p class="text-sm font-semibold">{practiceStats.googleRating} · {practiceStats.reviewCount}+ Google reviews</p>
          </div>
        </div>
      </section>

      <ReviewSlider />

      <ContactBand title="Ready to take the next step?" />
    </main>
    <PracticeFooter />
  </div>
</Layout>
