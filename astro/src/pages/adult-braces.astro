---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import PageHero from "../components/PageHero.astro";
import ContactBand from "../components/ContactBand.astro";
import { serviceHeroes } from "../lib/data";

const adultBracesBenefits = [
  ["Built for your schedule", "Options designed to move faster than traditional braces, without the 2-3 year commitment."],
  ["Confidence, day to day", "In an American Association of Orthodontists survey, 75% of adults reported improvements in career or personal relationships after treatment."],
  ["Health, long term", "Straighter teeth are easier to keep clean, which helps prevent tooth loss and gum disease over time."],
] as const;
---

<Layout title="Adult Braces | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow="Adult Braces"
        title="Alignment on an adult timeline."
        body="A faster path to a straighter smile, built for adults who want results without spending years in traditional braces."
        image={serviceHeroes.adultBraces.image}
        imagePosition={serviceHeroes.adultBraces.position}
        imageMobile={serviceHeroes.adultBraces.mobile}
      >
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact-us"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a consultation</a>
          <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Ask a question</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="eyebrow">Why adults choose this path</p>
            <h2 class="display-face mt-4 max-w-2xl text-4xl leading-[.98] tracking-[-.025em] text-[#2b2930] sm:text-5xl">A more discreet, more direct route.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[#596966]">Adult orthodontics doesn't have to mean years of metal brackets. We'll talk through options built for an adult timeline, so you can move toward a straighter smile with a plan that fits your life now, not just eventually.</p>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#f6d1bd]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">An orthodontic consultation.</p>
            <p class="mt-4 text-sm leading-7 text-[#d8e8e5]">We will assess your bite and alignment and talk through what's realistic for your timeline.</p>
            <a href="/contact-us" class="action-button light mt-6 w-full">Request a consultation <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="mt-14">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Why it's worth it</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">More than a straighter smile.</h3>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#596966]">In the same survey, 92% of adult orthodontic patients said they'd recommend treatment to other adults.</p>
          </div>
          <div class="service-option-grid mt-8">
            {adultBracesBenefits.map(([name, copy], index) => (
              <article class="service-option">
                <span class="service-option__number">0{index + 1}</span>
                <div>
                  <h4 class="display-face text-2xl leading-none text-[#2b2930]">{name}</h4>
                  <p class="mt-3 text-sm leading-6 text-[#596966]">{copy}</p>
                </div>
                <Icon name="lucide:check" class="service-option__check h-5 w-5" />
              </article>
            ))}
          </div>
        </section>

        <section class="related-services mt-16">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#27594e] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/orthodontics" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Orthodontics</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">Traditional and Invisalign options for patients of every age.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/cosmetic-dentistry" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Cosmetic Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">A personalized approach to a smile that feels like you.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/whitening" class="related-service-link">
              <span class="related-service-link__number">03</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Whitening</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">A brighter smile planned around your goals.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title="A more confident smile starts with a conversation." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
