---
import { Icon } from "astro-icon/components";
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { liveAssets, practiceStats } from "../lib/data";
import SectionHead from "../components/content/SectionHead.astro";
import CardGrid from "../components/content/CardGrid.astro";
import LeadList from "../components/content/LeadList.astro";
import FaqList from "../components/content/FaqList.astro";
import * as c from "../content-pages/home";
import PatientInfoMenu from "../components/PatientInfoMenu.astro";
import ServicesMenu from "../components/ServicesMenu.astro";
import MobileNav from "../components/MobileNav.astro";
import ReviewSlider from "../components/ReviewSlider.astro";
import StarIcon from "../components/StarIcon.astro";
import ContactForm from "../components/ContactForm.astro";

const heroPoster = await getImage({ src: liveAssets.office, width: 1440, widths: [640, 768, 960, 1440, 1920], sizes: "100vw", format: "webp" });
---

<Layout title={c.meta.title} description={c.meta.description}>
  <div class="page-shell min-h-screen overflow-x-hidden">
    <header class="relative z-20 bg-[#ffffff]/95 backdrop-blur-md">
      <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:px-12 xl:grid xl:grid-cols-[1fr_auto_1fr]">
        <a class="block w-[190px] sm:w-[220px] xl:w-[260px] xl:justify-self-start" href="/" aria-label="Dr. Brian Mitchell & Associates home">
          <Image src={liveAssets.logoTrimmed} class="h-auto w-full" alt="Dr. Brian Mitchell & Associates Dentistry, Dental Implants, Orthodontics" widths={[190, 220, 260, 380, 440, 520]} sizes="(min-width: 1280px) 260px, (min-width: 640px) 220px, 190px" loading="eager" />
        </a>
        <nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
          <ServicesMenu id="home-desktop" />
          <a class="nav-link" href="/about/">About</a>
          <PatientInfoMenu id="home-desktop" />
          <a class="nav-link" href="/patient-info/blogs/">Blogs</a>
          <a class="nav-link" href="/contact/">Contact</a>
        </nav>
        <div class="hidden items-center gap-3 sm:flex xl:justify-self-end">
          <a class="action-button outline" href="tel:5208816767"><Icon name="lucide:phone" class="h-3.5 w-3.5" />Call us</a>
          <a class="action-button primary" href="/contact/"><Icon name="lucide:calendar-days" class="h-3.5 w-3.5" />Book an appointment</a>
        </div>
        <button id="home-menu-toggle" class="rounded-full border border-[#729f9a]/40 p-3 text-[#354a4d] sm:hidden" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="home-mobile-menu">
          <Icon name="lucide:menu" class="h-5 w-5" data-menu-icon="open" />
          <Icon name="lucide:x" class="hidden h-5 w-5" data-menu-icon="close" />
        </button>
      </div>
      <MobileNav id="home-mobile-menu" />
    </header>

    <main id="top">
      <section class="homepage-hero relative isolate overflow-hidden bg-[#e6efee] text-[#283e3c]">
        <div class="homepage-hero__video-band relative">
          <div class="video-hero inset-0" aria-label="Dr. Brian Mitchell & Associates treatment room and dental technology">
            <img class="video-fallback" src={heroPoster.src} srcset={heroPoster.srcSet.attribute} sizes="100vw" width={heroPoster.attributes.width} height={heroPoster.attributes.height} alt="Dr. Brian Mitchell & Associates treatment room" fetchpriority="high" decoding="async" />
            <video class="video-fallback" autoplay loop muted playsinline preload="none" data-src={liveAssets.heroVideo} aria-label="Dr. Brian Mitchell & Associates building and dental technology tour"></video>
          </div>
          <div class="hero-overlay absolute inset-0 hidden lg:block"></div>
          <div class="homepage-hero__video-scrim absolute inset-x-0 bottom-0 lg:hidden" aria-hidden="true"></div>
          <div class="hero-media-label">Practice · equipment · technology</div>
        </div>
        <div class="homepage-hero__copy-band relative">
          <div class="homepage-hero__content relative mx-auto flex max-w-[1440px] items-end px-5 pb-10 pt-9 sm:px-8 lg:px-12 lg:pb-20 lg:pt-16 xl:pl-20">
            <div class="homepage-hero__copy-panel">
              <h1 class="fade-up display-face max-w-xl text-5xl leading-[.95] tracking-[-.035em] sm:text-6xl lg:text-[4.1rem] xl:text-[4.4rem]">{c.hero.title}</h1>
              <p class="fade-up delay-3 homepage-hero__subtitle">{c.hero.subtitle}</p>
              <p class="fade-up delay-3 mt-5 max-w-lg text-[.95rem] leading-7 text-[#4f5f5c]">{c.hero.intro}</p>
              <div class="fade-up delay-3 mt-7 flex flex-col gap-3 sm:flex-row">
                <a class="action-button primary" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book an Appointment</a>
                <a class="action-button hero-outline" href="tel:5208816767"><Icon name="lucide:phone" class="h-4 w-4" />Call (520) 881-6767</a>
              </div>
              <div class="fade-up delay-3 mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[#354a4d]/20 pt-5">
                <svg viewBox="0 0 48 48" class="h-5 w-5 flex-none" aria-hidden="true">
                  <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                  <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                  <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                  <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                <div class="flex gap-1">
                  {[0, 1, 2, 3, 4].map(() => <StarIcon class="h-4 w-4 text-[#fbbc05]" />)}
                </div>
                <p class="text-sm font-semibold text-[#283e3c]"><strong>{practiceStats.googleRating}</strong> · {practiceStats.reviewCount}+ Google reviews</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="homepage-trust-strip bg-[#e6efee] text-[#354a4d]">
        <ul class="mx-auto grid max-w-[1440px] gap-5 px-5 py-7 sm:px-8 md:grid-cols-3 md:gap-0 lg:px-12">
          {c.trust.map((item, index) => (
            <li class={`flex items-center gap-4 md:justify-center ${index < c.trust.length - 1 ? "md:border-r md:border-[#354a4d]/18" : ""}`}>
              <span class="grid h-10 w-10 flex-none place-items-center rounded-full bg-[#354a4d]/10"><Icon name={["lucide:clock-3", "lucide:shield-check", "lucide:award"][index]} class="h-4 w-4" /></span>
              <p class="text-sm font-extrabold leading-6">{item}</p>
            </li>
          ))}
        </ul>
      </section>

      <ReviewSlider />

      <section id="about" class="relative mx-auto max-w-[1440px] overflow-hidden px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
        <div class="relative grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
          <div class="relative">
            <div class="absolute -left-3 -top-3 h-full w-full border border-[#5f8f8a]/55"></div>
            <Image src={liveAssets.brian} alt="Dr. Brian Mitchell" class="relative aspect-[4/4.6] w-full object-cover object-[center_22%]" width={640} />
          </div>
          <div>
            <p class="eyebrow">Why Dr. Mitchell?</p>
            <h2 class="display-face mt-4 max-w-xl text-4xl leading-[.98] tracking-[-.025em] text-[#283e3c] sm:text-5xl">A Tucson Dentist Who Puts You First</h2>
            {c.firstParagraphs.map((text, index) => <p class={`${index ? "mt-5" : "mt-6"} max-w-xl text-base leading-8 text-[#4a5a58]`}>{text}</p>)}
            <a class="action-button dark mt-8" href="/about/">Learn more about our practice <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>
      </section>

      <section id="common-problems" class="mx-auto max-w-[1440px] px-5 pb-20 sm:px-8 lg:px-12 lg:pb-28">
        <SectionHead eyebrow="How we can help" title="Common Dental Problems We Help Tucson Patients Solve" />
        <div class="mt-9"><CardGrid items={c.problems} /></div>
      </section>

      <section id="services" class="bg-[#f0f5f4]">
        <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
          <SectionHead eyebrow="Our services" title="Dental Services in Tucson, AZ" />
          <div class="compact-service-grid mt-9">
            {c.services.map(([name, copy, href], index) => (
              <a href={href} class="compact-service-card group">
                <span class="compact-service-card__number">{String(index + 1).padStart(2, "0")}</span>
                <span class="compact-service-card__copy"><strong>{name}</strong><span>{copy}</span></span>
                <Icon name="lucide:arrow-right" class="compact-service-card__arrow h-4 w-4" />
              </a>
            ))}
          </div>
          <div class="mt-9 flex justify-center">
            <a class="action-button outline" href="/services/">Explore all services <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>
      </section>

      <section id="why" class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
        <div class="grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
          <div>
            <SectionHead eyebrow="Why choose us" title="Why Tucson Patients Choose Dr. Mitchell" />
            <div class="mt-8"><LeadList items={c.why} columns={1} /></div>
          </div>
          <div class="home-payment-panel">
            <SectionHead eyebrow="Insurance and payment" title="Insurance, Savings Plan and Payment Options" intro={c.paymentIntro} />
            <div class="mt-7"><LeadList items={c.payment} columns={1} /></div>
            <a class="action-button dark mt-8" href="/patient-info/financial/">See Financing &amp; Insurance <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>
      </section>

      <section id="dentists" class="bg-[#f0f5f4]">
        <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
          <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
            <SectionHead eyebrow="Our doctors" title="Meet Your Tucson Dentists" />
            <a class="action-button outline self-start sm:self-auto" href="/about/#team">Meet the Team <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
          <div class="mt-9 grid gap-6 md:grid-cols-2">
            {c.dentists.map((dentist, index) => (
              <article class="home-dentist">
                <Image src={index === 0 ? liveAssets.brian : liveAssets.amanKaur} alt={dentist.name} class="home-dentist__photo" width={480} />
                <div class="p-6 sm:p-7">
                  <h3 class="display-face text-3xl leading-none text-[#283e3c]">{dentist.name}</h3>
                  <p class="mt-2 text-[.66rem] font-extrabold uppercase tracking-[.12em] text-[#354a4d]">{dentist.role}</p>
                  <p class="mt-4 text-sm leading-7 text-[#4a5a58]">{dentist.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="new-patients" class="relative overflow-hidden bg-[#283e3c] text-white">
        <div class="sun-portal wide -bottom-24 -right-16 border-[#729f9a]/80" aria-hidden="true"></div>
        <div class="relative mx-auto flex max-w-[1440px] flex-col items-start justify-between gap-8 px-5 py-16 sm:px-8 md:flex-row md:items-center lg:px-12 lg:py-20">
          <div class="max-w-2xl">
            <p class="eyebrow text-[#9dbfbb]">New patients</p>
            <h2 class="display-face mt-4 text-4xl leading-[.98] tracking-[-.025em] sm:text-5xl">New Patient Specials</h2>
            <p class="mt-5 text-base leading-8 text-[#d5e4e2]">{c.specials}</p>
          </div>
          <a class="action-button primary flex-none" href="/new-patient-specials/">See new patient specials <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
        </div>
      </section>

      <section id="faq" class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
        <SectionHead eyebrow="Questions" title="Frequently Asked Questions" />
        <div class="mt-8"><FaqList items={c.faqs} /></div>
      </section>

      <section id="contact" class="relative overflow-hidden bg-[#354a4d] text-white">
        <div class="sun-portal wide -left-40 -bottom-24 border-[#d5e4e2]/70" aria-hidden="true"></div>
        <div class="relative mx-auto grid max-w-[1440px] gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[1fr_.95fr] lg:items-start lg:px-12 lg:py-28">
          <div>
            <p class="eyebrow text-[#d5e4e2]">Visit us</p>
            <h2 class="display-face mt-4 max-w-xl text-4xl leading-[.98] tracking-[-.03em] sm:text-5xl">Visit Our East Tucson Dental Office</h2>
            <p class="mt-6 max-w-lg text-base leading-8 text-white/85">{c.visit}</p>
            <div class="mt-10 grid gap-8 border-t border-white/25 pt-8 sm:grid-cols-2">
              <div>
                <p class="text-[.62rem] font-extrabold uppercase tracking-[.16em] text-[#d5e4e2]">Visit us</p>
                <p class="mt-3 text-base font-bold leading-7">6383 E. Grant Road, Suite 155<br />Tucson, AZ 85715</p>
              </div>
              <div>
                <p class="text-[.62rem] font-extrabold uppercase tracking-[.16em] text-[#d5e4e2]">Office hours</p>
                <p class="mt-3 text-sm leading-7 text-white/85">Monday to Tuesday, 8am to 4pm<br />Wednesday to Friday, 7am to 4pm</p>
              </div>
            </div>
            <div class="mt-10 border-t border-white/25 pt-8">
              <h3 class="display-face text-3xl leading-none">{c.closing.title}</h3>
              <p class="mt-4 max-w-lg text-base leading-8 text-white/85">{c.closing.text}</p>
              <div class="mt-7 flex flex-col gap-3 sm:flex-row">
                <a class="action-button dark" href="tel:5208816767"><Icon name="lucide:phone" class="h-4 w-4" />Call (520) 881-6767</a>
                <a class="action-button light" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Request an appointment</a>
              </div>
            </div>
          </div>
          <div class="bg-[#ffffff] p-6 text-[#283e3c] shadow-[0_24px_60px_rgba(40,62,60,.28)] sm:p-9">
            <p class="eyebrow">Message us</p>
            <h3 class="display-face mt-3 text-3xl leading-none sm:text-4xl">What can we help with?</h3>
            <p class="mt-4 text-sm leading-7 text-[#4a5a58]">Share a few details and our team will be in touch. For privacy, please do not include sensitive health information in this form.</p>
            <ContactForm id="home" class="mt-7" />
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-[#ffffff] pb-24 md:pb-0">
      <div class="mx-auto flex max-w-[1440px] flex-col justify-between gap-7 px-5 py-10 sm:px-8 md:flex-row md:items-center lg:px-12">
        <Image src={liveAssets.logo} alt="Dr. Brian Mitchell & Associates" class="w-[210px]" width={410} />
        <p class="max-w-md text-xs leading-5 text-[#4f5f5c]">Dentistry · Dental Implants · Orthodontics</p>
        <div class="flex items-center gap-3 border-l-2 border-[#729f9a] pl-3">
          <Image src={liveAssets.bioclear} alt="Dr. Brian Mitchell BioClear Certified" class="h-16 w-16 object-contain" width={128} />
          <p class="max-w-[155px] text-[0.64rem] font-extrabold uppercase leading-4 tracking-[0.11em] text-[#354a4d]">Dr. Brian Mitchell<br />BioClear Certified</p>
        </div>
      </div>
      <div class="border-t border-[#729f9a]/20">
        <div class="mx-auto flex max-w-[1440px] flex-col gap-2 px-5 py-5 text-xs leading-6 text-[#4f5f5c] sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
          <p>&copy; {new Date().getFullYear()} Dr. Brian Mitchell & Associates. All rights reserved.</p>
          <p>Website designed by <a href="https://khalismarketing.com.au" target="_blank" rel="noopener" class="font-bold text-[#354a4d] underline underline-offset-2">Khalis Marketing</a></p>
        </div>
      </div>
    </footer>
    <div class="fixed inset-x-0 bottom-0 z-30 flex items-center gap-3 bg-[#ffffff]/95 px-4 py-3 shadow-[0_-6px_30px_rgba(26,29,30,.13)] backdrop-blur md:hidden">
      <a class="action-button outline flex-1 py-3" href="tel:5208816767"><Icon name="lucide:phone" class="h-3.5 w-3.5" />Call</a>
      <a class="action-button primary flex-1 py-3" href="/contact/"><Icon name="lucide:calendar-days" class="h-3.5 w-3.5" />Book</a>
    </div>
  </div>
</Layout>

<script>
  // The poster image is the LCP element; the video only starts fetching once the page has loaded so it doesn't compete with it.
  const heroVideo = document.querySelector<HTMLVideoElement>("video[data-src]");
  const startHeroVideo = () => {
    if (!heroVideo || heroVideo.src) return;
    heroVideo.src = heroVideo.dataset.src ?? "";
    heroVideo.addEventListener("playing", () => { document.querySelector<HTMLImageElement>("img.video-fallback")?.setAttribute("hidden", ""); }, { once: true });
    heroVideo.play().catch(() => {});
  };
  if (document.readyState === "complete") setTimeout(startHeroVideo, 400);
  else window.addEventListener("load", () => setTimeout(startHeroVideo, 400), { once: true });

  const toggle = document.getElementById("home-menu-toggle");
  const menu = document.getElementById("home-mobile-menu");
  const openIcon = toggle?.querySelector('[data-menu-icon="open"]');
  const closeIcon = toggle?.querySelector('[data-menu-icon="close"]');

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    openIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  });
</script>
