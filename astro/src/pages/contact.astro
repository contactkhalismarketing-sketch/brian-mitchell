---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import { liveAssets } from "../lib/data";
---

<Layout title="Contact | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="contact" />
    <main>
      <PageHero
        eyebrow="Contact us"
        title="We'd love to hear from you."
        body="Call, send a note, or request a visit. Our team is here to answer questions and help you find a time that works for you."
        image={liveAssets.office}
        imagePosition="82% 40%"
      >
        <div class="mt-9 flex gap-3">
          <a class="action-button primary" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Call (520) 523-4860</a>
          <a class="action-button outline" href="mailto:checkin@brianmitchelldds.com">Send an email <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
        </div>
      </PageHero>
      <section class="mx-auto grid max-w-[1440px] gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[.95fr_1.05fr] lg:px-12 lg:py-28">
        <div class="relative overflow-hidden rounded-[1.5rem] bg-[#dcedf4] shadow-[0_20px_55px_rgba(27,61,73,.12)]">
          <iframe
            class="h-[560px] w-full"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Dr. Brian Mitchell & Associates location"
            src="https://www.google.com/maps?q=6383+E+Grant+Rd+Suite+155,+Tucson,+AZ+85715&output=embed"
          ></iframe>
          <div class="absolute bottom-5 left-5 bg-[#ffffff] p-5 shadow-lg">
            <p class="eyebrow">Visit the practice</p>
            <p class="mt-2 text-sm font-extrabold leading-6 text-[#1f2b33]">6383 E. Grant Road, Suite 155<br />Tucson, AZ 85715</p>
            <a href="https://maps.app.goo.gl/Fo6RRMdcgjxbApEWA" target="_blank" rel="noreferrer" class="mt-3 inline-flex items-center gap-1 text-xs font-extrabold uppercase tracking-[.1em] text-[#1d5f73] no-underline">Get directions <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" /></a>
          </div>
        </div>
        <div>
          <p class="eyebrow">Message us</p>
          <h2 class="display-face mt-4 text-4xl leading-none text-[#1f2b33] sm:text-5xl">What can we help with?</h2>
          <p class="mt-5 max-w-lg text-sm leading-7 text-[#4d6270]">Share a few details and our team will be in touch. For privacy, please do not include sensitive health information in this form.</p>
          <ContactForm id="contact" class="mt-8" />
        </div>
      </section>
      <section class="bg-[#eef5f9]">
        <div class="mx-auto grid max-w-[1440px] gap-8 px-5 py-14 sm:px-8 md:grid-cols-3 lg:px-12">
          <div>
            <Icon name="lucide:clock-3" class="h-6 w-6 text-[#8c6a30]" />
            <p class="mt-4 font-extrabold text-[#1f2b33]">Office hours</p>
            <p class="mt-2 text-sm leading-7 text-[#4d6270]">Monday–Tuesday · 8am–4pm<br />Wednesday–Friday · 7am–4pm</p>
          </div>
          <div>
            <Icon name="lucide:phone" class="h-6 w-6 text-[#8c6a30]" />
            <p class="mt-4 font-extrabold text-[#1f2b33]">Same-day appointments</p>
            <p class="mt-2 text-sm leading-7 text-[#4d6270]">Call the practice to ask about today's availability.</p>
          </div>
          <div>
            <Icon name="lucide:sparkles" class="h-6 w-6 text-[#8c6a30]" />
            <p class="mt-4 font-extrabold text-[#1f2b33]">Payment options</p>
            <p class="mt-2 text-sm leading-7 text-[#4d6270]">PPO insurance, CareCredit&reg;, and our $650/year in-house savings plan. <a href="/patient-info/financial/" class="font-bold text-[#1d5f73] underline underline-offset-2">See financing options</a>.</p>
          </div>
        </div>
      </section>
    </main>
    <PracticeFooter />
  </div>
</Layout>
