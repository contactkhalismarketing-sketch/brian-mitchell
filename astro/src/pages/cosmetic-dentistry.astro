---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import ContactBand from "../components/ContactBand.astro";
import CosmeticSplitHero from "../components/CosmeticSplitHero.astro";
import PorcelainVideoPanel from "../components/PorcelainVideoPanel.astro";
import { cosmeticOptions } from "../lib/data";
---

<Layout title="Cosmetic Dentistry | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <CosmeticSplitHero>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact-us"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a consultation</a>
          <a class="action-button light" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Ask a question</a>
        </div>
      </CosmeticSplitHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="eyebrow">The art of a natural smile</p>
            <h2 class="display-face mt-4 max-w-2xl text-4xl leading-[.98] tracking-[-.025em] text-[#2b2930] sm:text-5xl">A plan that starts with how you want to feel.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[#596966]">Dr. Mitchell considers every facet of care, from the health and structure of your teeth to the details that make a result look and feel like you. We start with a clear conversation and an honest assessment.</p>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#f6d1bd]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">A smile consultation.</p>
            <p class="mt-4 text-sm leading-7 text-[#d8e8e5]">Bring your questions. We will help you understand what is possible and what is appropriate for your smile.</p>
            <a href="/contact-us" class="action-button light mt-6 w-full">Request a consultation <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="mt-14">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Explore your options</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">Care should feel easier to understand.</h3>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#596966]">These are common cosmetic options. Your treatment plan is always tailored to your health, priorities, and timeline.</p>
          </div>
          <div class="service-option-grid mt-8">
            {cosmeticOptions.map(([name, copy], index) => (
              <article class="service-option">
                <span class="service-option__number">0{index + 1}</span>
                <div>
                  <h4 class="display-face text-2xl leading-none text-[#2b2930]">{name}</h4>
                  <p class="mt-3 text-sm leading-6 text-[#596966]">{copy}</p>
                </div>
                <Icon name="lucide:check" class="service-option__check h-5 w-5" />
              </article>
            ))}
          </div>
        </section>

        <section class="mt-16 grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-stretch">
          <article class="service-copy-panel">
            <p class="eyebrow">Porcelain veneers</p>
            <h3 class="display-face mt-3 text-4xl leading-none text-white">A thoughtful way to refine the details.</h3>
            <p class="mt-6 text-base leading-8 text-[#d8e8e5]">Porcelain veneers are delicate facings applied to the front teeth. In the right situation, they can help refine shape, shade, or small imperfections while preserving a natural appearance.</p>
            <div class="mt-7 border-t border-white/15 pt-6">
              <p class="text-sm font-extrabold text-white">Your consultation includes</p>
              <p class="mt-2 text-sm leading-7 text-[#d8e8e5]">Time to understand your goals, discuss what is clinically appropriate, and review your options together.</p>
            </div>
          </article>
          <PorcelainVideoPanel />
        </section>

        <section class="related-services mt-16">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#27594e] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/dental-implants" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Dental Implants</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">Replace missing teeth with care that supports comfort, function, and confidence.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/orthodontics" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Orthodontics</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">Explore clear, thoughtful options to bring alignment into focus.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/preventative-dentistry" class="related-service-link">
              <span class="related-service-link__number">03</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Preventative Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">Build a healthy foundation with consistent, patient-first care.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title="A more confident smile starts with a conversation." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
