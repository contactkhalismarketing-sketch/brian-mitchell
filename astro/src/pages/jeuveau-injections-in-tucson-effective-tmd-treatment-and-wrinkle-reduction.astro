---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import PageHero from "../components/PageHero.astro";
import ContactBand from "../components/ContactBand.astro";
import { serviceHeroes } from "../lib/data";

const jeuveauUses = [
  ["TMJ, clenching and grinding", "Targeted injections into the jaw muscles reduce the tension behind clenching and grinding (bruxism) and ease TMJ discomfort. Many patients notice improvement within days, along with easier chewing and speaking, and for some, fewer headaches."],
  ["Wrinkle reduction", "Smooths forehead lines, crow's feet, and smile lines for a refreshed, natural look, without a frozen appearance. Results last around 3 to 4 months, so most patients return about three times a year."],
  ["What to expect", "Our hygienist administers precise injections with ultra-fine needles in a 10 to 15 minute visit, with minimal downtime. Results appear within 2 to 3 days, peak at around 30 days, and last 3 to 6 months. Side effects are minimal, occasionally mild bruising or swelling."],
] as const;
---

<Layout title="Jeuveau Injections | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow="Jeuveau Injections"
        title="Relief for clenching and grinding. A softer look, too."
        body="Jeuveau is a newer alternative to Botox, administered by our hygienist for TMJ symptoms, clenching and grinding, and facial wrinkles, in a quick 10 to 15 minute visit."
        image={serviceHeroes.jeuveau.image}
        imagePosition={serviceHeroes.jeuveau.position}
        imageMobile={serviceHeroes.jeuveau.mobile}
      >
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a consultation</a>
          <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Ask a question</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="eyebrow">Two uses, one treatment</p>
            <h2 class="display-face mt-4 max-w-2xl text-4xl leading-[.98] tracking-[-.025em] text-[#2b2930] sm:text-5xl">One injection, for jaw tension or fine lines.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[#596966]">Jeuveau works by relaxing the muscles it's placed in. Aimed at the jaw, that takes the pressure off clenching and grinding and calms TMJ symptoms. Used around the forehead, eyes, and mouth, the same approach smooths wrinkles for a refreshed look that still moves like you.</p>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#f6d1bd]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">A Jeuveau consultation.</p>
            <p class="mt-4 text-sm leading-7 text-[#d8e8e5]">We will talk through whether it's a good fit for you, what to expect, and how often you would want to come back.</p>
            <a href="/contact/" class="action-button light mt-6 w-full">Request a consultation <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="mt-14">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">How it helps</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">Comfort first, appearance second.</h3>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#596966]">In a survey of users, 74% preferred Jeuveau and 9 in 10 said they would recommend it.</p>
          </div>
          <div class="service-option-grid mt-8">
            {jeuveauUses.map(([name, copy], index) => (
              <article class="service-option">
                <span class="service-option__number">0{index + 1}</span>
                <div>
                  <h4 class="display-face text-2xl leading-none text-[#2b2930]">{name}</h4>
                  <p class="mt-3 text-sm leading-6 text-[#596966]">{copy}</p>
                </div>
                <Icon name="lucide:check" class="service-option__check h-5 w-5" />
              </article>
            ))}
          </div>
        </section>

        <section class="related-services mt-16">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services/" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#27594e] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/service/preventative-dentistry/" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Preventative Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">Every exam includes a check of your jaw joint and bite.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/cosmetic-dentistry/" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Cosmetic Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">A personalized approach to a smile that feels like you.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/service/whitening/" class="related-service-link">
              <span class="related-service-link__number">03</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Whitening</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">A brighter smile planned around your goals.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title="Curious whether Jeuveau is right for you?" />
    </main>
    <PracticeFooter />
  </div>
</Layout>
