---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import PageHero from "../components/PageHero.astro";
import ContactBand from "../components/ContactBand.astro";
import { liveAssets } from "../lib/data";

const bioclearSteps = [
  ["Matrix placement", "A specially designed plastic form is fitted around your tooth, shaping the space the new material will fill."],
  ["Composite injection", "Warmed composite resin, matched to your natural tooth color, is injected into the matrix and shaped to your tooth."],
  ["Curing and polishing", "The composite is hardened with light, the matrix removed, and the tooth carefully polished for a seamless, natural finish."],
] as const;
---

<Layout title="Bioclear | Dr. Brian Mitchell & Associates">
  <div class="page-shell min-h-screen">
    <PracticeHeader active="services" />
    <main>
      <PageHero
        eyebrow="Bioclear"
        title="A natural-looking repair, without removing your tooth."
        body="An additive, tooth-colored restoration that builds on your natural tooth structure instead of filing it down, often completed in a single visit."
        image={liveAssets.office}
      >
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="action-button primary" href="/contact-us"><Icon name="lucide:calendar-days" class="h-4 w-4" />Book a consultation</a>
          <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-4 w-4" />Ask a question</a>
        </div>
      </PageHero>
      <section class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
        <div class="service-intro-stage">
          <div>
            <p class="eyebrow">Built to protect what's already yours</p>
            <h2 class="display-face mt-4 max-w-2xl text-4xl leading-[.98] tracking-[-.025em] text-[#2b2930] sm:text-5xl">An additive approach to a healthier smile.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[#596966]">Because Bioclear builds onto your tooth rather than removing structure, it helps protect your enamel while closing gaps near the gum line, restoring worn teeth, and supporting healthier gums. Bioclear restorations can last over 10 years with proper care, and leave no gaps or ridges that trap bacteria.</p>
          </div>
          <div class="service-next-step">
            <p class="eyebrow text-[#f6d1bd]">Your next step</p>
            <p class="display-face mt-3 text-3xl leading-none text-white">A Bioclear consultation.</p>
            <p class="mt-4 text-sm leading-7 text-[#d8e8e5]">We will look at what's bothering you about a tooth and talk through whether Bioclear is the right, conservative fit.</p>
            <a href="/contact-us" class="action-button light mt-6 w-full">Request a consultation <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
          </div>
        </div>

        <section class="mt-14">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">How it works</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">Three steps, one appointment.</h3>
            </div>
            <p class="max-w-md text-sm leading-7 text-[#596966]">Most Bioclear procedures are completed in a single visit, with minimal discomfort.</p>
          </div>
          <div class="service-option-grid mt-8">
            {bioclearSteps.map(([name, copy], index) => (
              <article class="service-option">
                <span class="service-option__number">0{index + 1}</span>
                <div>
                  <h4 class="display-face text-2xl leading-none text-[#2b2930]">{name}</h4>
                  <p class="mt-3 text-sm leading-6 text-[#596966]">{copy}</p>
                </div>
                <Icon name="lucide:check" class="service-option__check h-5 w-5" />
              </article>
            ))}
          </div>
        </section>

        <section class="related-services mt-16">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
              <p class="eyebrow">Continue your care</p>
              <h3 class="display-face mt-3 text-3xl leading-none text-[#2b2930] sm:text-4xl">You may also be interested in.</h3>
            </div>
            <a href="/services" class="text-sm font-extrabold uppercase tracking-[.12em] text-[#27594e] no-underline">View all services <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" /></a>
          </div>
          <div class="related-services__grid mt-8">
            <a href="/cosmetic-dentistry" class="related-service-link">
              <span class="related-service-link__number">01</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Cosmetic Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">A personalized approach to a smile that feels like you.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
            <a href="/preventative-dentistry" class="related-service-link">
              <span class="related-service-link__number">02</span>
              <span>
                <span class="display-face block text-2xl leading-none text-[#2b2930]">Preventative Dentistry</span>
                <span class="mt-2 block text-sm leading-6 text-[#596966]">Build a healthy foundation with consistent, patient-first care.</span>
              </span>
              <Icon name="lucide:arrow-right" class="related-service-link__arrow h-5 w-5" />
            </a>
          </div>
        </section>
      </section>
      <ContactBand title="A more confident smile starts with a conversation." />
    </main>
    <PracticeFooter />
  </div>
</Layout>
