---
import { Icon } from "astro-icon/components";
import { patientInfoMenu } from "../lib/data";

interface Props {
  active?: boolean;
  id: string;
}

const { active = false, id } = Astro.props;
---

<div class="patient-info-menu relative">
  <button
    type="button"
    class={`nav-link patient-info-menu__trigger inline-flex items-center gap-1 ${active ? "text-[#354d49]" : ""}`}
    aria-expanded="false"
    aria-haspopup="true"
    data-patient-info-trigger={id}
  >
    Patient Info
    <Icon name="lucide:chevron-down" class="h-3 w-3 transition-transform" data-patient-info-chevron={id} />
  </button>
  <div
    class="patient-info-menu__panel absolute left-0 top-full z-40 hidden min-w-[210px] pt-3"
    data-patient-info-panel={id}
  >
    <div class="border border-[#e2ca9f]/25 bg-[#ffffff] py-2 shadow-[0_18px_36px_rgba(53,77,73,.14)]">
      {patientInfoMenu.map((item) => (
        <a href={item.href} class="block px-5 py-2.5 text-xs font-bold uppercase tracking-[.08em] text-[#082824] no-underline hover:bg-[#f7f2e8] hover:text-[#354d49]">{item.label}</a>
      ))}
    </div>
  </div>
</div>

<script>
  function setupPatientInfoMenus() {
    document.querySelectorAll("[data-patient-info-trigger]").forEach((trigger) => {
      const id = trigger.getAttribute("data-patient-info-trigger");
      const panel = document.querySelector(`[data-patient-info-panel="${id}"]`);
      const chevron = document.querySelector(`[data-patient-info-chevron="${id}"]`);
      if (!panel) return;

      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        const isOpen = panel.classList.toggle("hidden") === false;
        trigger.setAttribute("aria-expanded", String(isOpen));
        chevron?.classList.toggle("rotate-180", isOpen);
      });
    });

    document.addEventListener("click", () => {
      document.querySelectorAll("[data-patient-info-panel]").forEach((panel) => panel.classList.add("hidden"));
      document.querySelectorAll("[data-patient-info-trigger]").forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
      document.querySelectorAll("[data-patient-info-chevron]").forEach((chevron) => chevron.classList.remove("rotate-180"));
    });
  }

  setupPatientInfoMenus();
</script>
