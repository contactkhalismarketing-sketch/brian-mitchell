---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { liveAssets, navigation } from "../lib/data";
import PatientInfoMenu from "./PatientInfoMenu.astro";
import ServicesMenu from "./ServicesMenu.astro";
import MobileNav from "./MobileNav.astro";

interface Props {
  active?: string;
}

const { active } = Astro.props;
const [servicesItem, aboutItem, ...restItems] = navigation;
---

<header class="relative z-30 bg-[#ffffff]/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:px-12">
    <a href="/" class="block w-[160px] sm:w-[205px]" aria-label="Dr. Brian Mitchell & Associates home">
      <Image src={liveAssets.logo} class="h-auto w-full" alt="Dr. Brian Mitchell & Associates Dentistry, Dental Implants, Orthodontics" widths={[160, 205, 320, 410]} sizes="(min-width: 640px) 205px, 160px" loading="eager" />
    </a>
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
      <ServicesMenu id="desktop" active={active === servicesItem.active} />
      <a href={aboutItem.href} class={`nav-link ${active === aboutItem.active ? "text-[#1d5f73]" : ""}`}>{aboutItem.label}</a>
      <PatientInfoMenu id="desktop" active={active === "patient-info"} />
      {restItems.map((item) => (
        <a href={item.href} class={`nav-link ${active === item.active ? "text-[#1d5f73]" : ""}`}>{item.label}</a>
      ))}
    </nav>
    <div class="hidden items-center gap-3 sm:flex">
      <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-3.5 w-3.5" />Call us</a>
      <a href="/contact/" class="action-button primary"><Icon name="lucide:calendar-days" class="h-3.5 w-3.5" />Book an appointment</a>
    </div>
    <button
      id="mobile-menu-toggle"
      class="rounded-full border border-[#8fc1d3]/40 p-3 text-[#1d5f73] sm:hidden"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="lucide:menu" class="h-5 w-5" data-menu-icon="open" />
      <Icon name="lucide:x" class="hidden h-5 w-5" data-menu-icon="close" />
    </button>
  </div>
  <MobileNav id="mobile-menu" />
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const openIcon = toggle?.querySelector('[data-menu-icon="open"]');
  const closeIcon = toggle?.querySelector('[data-menu-icon="close"]');

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    openIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  });
</script>
