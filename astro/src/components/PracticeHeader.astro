---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { liveAssets, navigation, patientInfoMenu, servicesMenu } from "../lib/data";
import PatientInfoMenu from "./PatientInfoMenu.astro";
import ServicesMenu from "./ServicesMenu.astro";

interface Props {
  active?: string;
}

const { active } = Astro.props;
const [servicesItem, aboutItem, ...restItems] = navigation;
---

<header class="relative z-30 bg-[#fffaf3]/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:px-12">
    <a href="/" class="block w-[160px] sm:w-[205px]" aria-label="Dr. Brian Mitchell & Associates home">
      <Image src={liveAssets.logo} class="h-auto w-full" alt="Dr. Brian Mitchell & Associates Dentistry, Dental Implants, Orthodontics" width={410} loading="eager" />
    </a>
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
      <ServicesMenu id="desktop" active={active === servicesItem.active} />
      <a href={aboutItem.href} class={`nav-link ${active === aboutItem.active ? "text-[#27594e]" : ""}`}>{aboutItem.label}</a>
      <PatientInfoMenu id="desktop" active={active === "patient-info"} />
      {restItems.map((item) => (
        <a href={item.href} class={`nav-link ${active === item.active ? "text-[#27594e]" : ""}`}>{item.label}</a>
      ))}
    </nav>
    <div class="hidden items-center gap-3 sm:flex">
      <a class="action-button outline" href="tel:5205234860"><Icon name="lucide:phone" class="h-3.5 w-3.5" />Call us</a>
      <a href="/contact-us" class="action-button primary"><Icon name="lucide:calendar-days" class="h-3.5 w-3.5" />Book an appointment</a>
    </div>
    <button
      id="mobile-menu-toggle"
      class="rounded-full border border-[#77a49f]/40 p-3 text-[#27594e] sm:hidden"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="lucide:menu" class="h-5 w-5" data-menu-icon="open" />
      <Icon name="lucide:x" class="hidden h-5 w-5" data-menu-icon="close" />
    </button>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-[#77a49f]/15 bg-[#fffaf3] px-5 py-5 sm:hidden" aria-label="Mobile navigation">
    <div class="grid gap-4">
      <div>
        <a class="nav-link" href={servicesItem.href}>{servicesItem.label}</a>
        <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2">
          {servicesMenu.map((item) => <a class="text-xs font-bold text-[#52736b] no-underline" href={item.href}>{item.label}</a>)}
        </div>
      </div>
      <a class="nav-link" href={aboutItem.href}>{aboutItem.label}</a>
      <div class="border-t border-[#77a49f]/15 pt-4">
        <p class="text-[.62rem] font-extrabold uppercase tracking-[.14em] text-[#8a9a96]">Patient info</p>
        <div class="mt-3 grid gap-3">
          {patientInfoMenu.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
        </div>
      </div>
      <div class="border-t border-[#77a49f]/15 pt-4">
        <div class="grid gap-4">
          {restItems.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
        </div>
      </div>
      <a class="action-button primary mt-2 w-full" href="/contact-us">Book an appointment <Icon name="lucide:calendar-days" class="h-4 w-4" /></a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const openIcon = toggle?.querySelector('[data-menu-icon="open"]');
  const closeIcon = toggle?.querySelector('[data-menu-icon="close"]');

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    openIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  });
</script>
