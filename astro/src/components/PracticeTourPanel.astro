---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { liveAssets } from "../lib/data";
---

<section class="about-practice-video-stage">
  <div class="about-practice-video mx-auto max-w-[1440px]">
    <div class="about-practice-video__copy">
      <div>
        <p class="eyebrow text-[#f6d1bd]">Inside the practice</p>
        <h2 class="display-face mt-4 max-w-lg text-4xl leading-[.96] tracking-[-.025em] text-white sm:text-5xl">A calm space, designed around your care.</h2>
        <p class="mt-6 max-w-lg text-sm leading-7 text-[#d8e8e5]">Take a closer look at the place, technology, and thoughtful details that support a more comfortable dental experience from the moment you arrive.</p>
      </div>
      <div class="about-practice-video__note">
        <span>What you will see</span>
        <p>Our Tucson practice, treatment spaces, and digital technology.</p>
      </div>
    </div>
    <div class="about-practice-video__frame" id="practice-tour-frame">
      <button class="about-practice-video__play" type="button" id="practice-tour-play" aria-label="Play Dr. Brian Mitchell & Associates practice tour">
        <Image src={liveAssets.office} alt="Dr. Brian Mitchell & Associates treatment room" width={900} />
        <span class="about-practice-video__overlay"></span>
        <span class="about-practice-video__play-button"><Icon name="lucide:play-circle" class="h-9 w-9" />Watch the practice tour</span>
      </button>
      <span class="about-practice-video__tag">Tucson, Arizona · Practice tour</span>
    </div>
  </div>
</section>

<script>
  const button = document.getElementById("practice-tour-play");

  button?.addEventListener("click", () => {
    const video = document.createElement("video");
    video.src = "/assets/practice/brian-mitchell-full-composition-practice-tour_5757208e.mp4";
    video.controls = true;
    video.autoplay = true;
    video.playsInline = true;
    video.style.cssText = "width:100%;height:100%;object-fit:cover;display:block;";
    button.replaceWith(video);
  });
</script>
