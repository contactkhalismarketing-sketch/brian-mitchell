---
import { Image } from "astro:assets";
import { liveAssets } from "../lib/data";
---

<section class="service-split-hero">
  <div class="service-split-hero__copy">
    <div class="relative z-10">
      <p class="eyebrow text-[#bde0da]">Cosmetic Dentistry</p>
      <h1 class="display-face mt-4 max-w-xl text-5xl leading-[.93] tracking-[-.035em] sm:text-6xl">Bring your smile into focus.</h1>
      <p class="mt-7 max-w-xl text-base leading-8 text-[#e7f1ee]">Cosmetic care begins with a clear conversation about what you would like to refine. We consider health, structure, and the details that help a result feel like you.</p>
      <slot />
    </div>
  </div>
  <div class="service-split-hero__video">
    <Image src={liveAssets.cosmeticHeroPoster} alt="Cosmetic Dentistry treatment at Dr. Brian Mitchell & Associates" width={900} loading="eager" />
    <span class="service-split-hero__video-overlay"></span>
    <span class="service-split-hero__tag">Cosmetic Dentistry · Tucson, AZ</span>
  </div>
</section>
