---
import { Icon } from "astro-icon/components";

interface Props {
  title?: string;
  text?: string;
}

const { title = "Let's make a plan for your smile.", text } = Astro.props;
---

<section class="relative overflow-hidden bg-[#354a4d] text-white">
  <div class="sun-portal wide -bottom-28 -right-10 border-[#d5e4e2]/70" aria-hidden="true"></div>
  <div class="relative mx-auto flex max-w-[1440px] flex-col items-start justify-between gap-7 px-5 py-12 sm:px-8 md:flex-row md:items-end lg:px-12 lg:pb-24">
    <div>
      <p class="eyebrow text-[#d5e4e2]">Book an appointment</p>
      <h2 class="display-face mt-3 max-w-xl text-4xl leading-none sm:text-5xl">{title}</h2>
      {text && <p class="mt-5 max-w-xl text-base leading-8 text-white/85" set:html={text.replace("(520) 881-6767", '<span class="whitespace-nowrap">(520) 881-6767</span>')} />}
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a class="action-button dark" href="tel:5208816767"><Icon name="lucide:phone" class="h-4 w-4" />Call (520) 881-6767</a>
      <a class="action-button light" href="/contact/"><Icon name="lucide:calendar-days" class="h-4 w-4" />Request a visit</a>
    </div>
  </div>
</section>
