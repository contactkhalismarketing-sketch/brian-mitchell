---
import { Icon } from "astro-icon/components";
import GoogleRatingBadge from "./GoogleRatingBadge.astro";
import { testimonials } from "../lib/data";
---

<section class="bg-[#f0f5f4]">
  <div class="mx-auto flex max-w-[900px] flex-col items-center px-5 py-16 text-center sm:px-8 lg:py-20">
    <GoogleRatingBadge size="lg" />
    <div class="review-slider mt-8 w-full" data-review-slider>
      <div class="review-slider__track" data-review-track>
        {testimonials.map((item) => (
          <div class="review-slider__slide">
            <Icon name="lucide:quote" class="mx-auto h-7 w-7 text-[#3f6e69]" />
            <p class="display-face mx-auto mt-5 max-w-2xl text-2xl leading-tight text-[#283e3c] sm:text-3xl">{item.quote}</p>
            <p class="mt-5 text-xs font-extrabold uppercase tracking-[.14em] text-[#354a4d]">— {item.author}, {item.source}</p>
          </div>
        ))}
      </div>
      <div class="mt-7 flex items-center justify-center gap-5">
        <button type="button" class="review-slider__nav" data-review-prev aria-label="Previous review">
          <Icon name="lucide:chevron-left" class="h-4 w-4" />
        </button>
        <div class="flex gap-2" data-review-dots>
          {testimonials.map((_, index) => (
            <button type="button" class="review-slider__dot" data-review-dot={index} aria-label={`Show review ${index + 1}`}></button>
          ))}
        </div>
        <button type="button" class="review-slider__nav" data-review-next aria-label="Next review">
          <Icon name="lucide:chevron-right" class="h-4 w-4" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function setupReviewSlider() {
    document.querySelectorAll<HTMLElement>("[data-review-slider]").forEach((root) => {
      const track = root.querySelector<HTMLElement>("[data-review-track]");
      const slides = Array.from(root.querySelectorAll<HTMLElement>(".review-slider__slide"));
      const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-review-dot]"));
      if (!track || slides.length === 0) return;

      // The track is a native horizontal scroller with scroll-snap, so touch swiping,
      // momentum and rubber-banding come from the browser. Arrows, dots and the
      // auto-advance simply scroll it; the dots follow wherever the user scrolls to.
      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;
      let scrollSettle: ReturnType<typeof setTimeout> | undefined;
      // Slide width is read once (and on resize) rather than inside scroll/timer callbacks, which forced layout.
      let slideWidth = track.clientWidth || 1;

      function markActive(i: number) {
        index = i;
        dots.forEach((dot, d) => dot.classList.toggle("is-active", d === index));
      }

      function show(next: number, smooth = true) {
        const target = (next + slides.length) % slides.length;
        markActive(target);
        track?.scrollTo({ left: target * slideWidth, behavior: smooth ? "smooth" : "auto" });
      }

      function restart() {
        if (timer) clearInterval(timer);
        timer = setInterval(() => show(index + 1), 7000);
      }

      track.addEventListener("scroll", () => {
        if (scrollSettle) clearTimeout(scrollSettle);
        scrollSettle = setTimeout(() => {
          if (!track) return;
          const i = Math.round(track.scrollLeft / slideWidth);
          if (i !== index) markActive(Math.max(0, Math.min(slides.length - 1, i)));
        }, 80);
      }, { passive: true });

      // Pause the auto-advance while a finger is on the reviews, resume after.
      track.addEventListener("touchstart", () => { if (timer) clearInterval(timer); }, { passive: true });
      track.addEventListener("touchend", restart, { passive: true });

      root.querySelector("[data-review-prev]")?.addEventListener("click", () => { show(index - 1); restart(); });
      root.querySelector("[data-review-next]")?.addEventListener("click", () => { show(index + 1); restart(); });
      dots.forEach((dot, i) => dot.addEventListener("click", () => { show(i); restart(); }));

      window.addEventListener("resize", () => { slideWidth = track.clientWidth || 1; show(index, false); });

      show(0, false);
      restart();
    });
  }

  setupReviewSlider();
</script>
