---
import { Icon } from "astro-icon/components";
import { servicesMenu } from "../lib/data";

interface Props {
  active?: boolean;
  id: string;
}

const { active = false, id } = Astro.props;
---

<div class="patient-info-menu relative">
  <span class={`nav-link inline-flex items-center gap-1 ${active ? "text-[#354a4d]" : ""}`}>
    <a href="/services/" class="services-menu__label">Services</a>
    <button
      type="button"
      class="services-menu__toggle patient-info-menu__trigger"
      aria-label="Show services menu"
      aria-expanded="false"
      aria-haspopup="true"
      data-services-trigger={id}
    >
      <Icon name="lucide:chevron-down" class="h-3 w-3 transition-transform" data-services-chevron={id} />
    </button>
  </span>
  <div
    class="patient-info-menu__panel services-menu__panel absolute left-0 top-full z-40 hidden w-[560px] pt-3"
    data-services-panel={id}
  >
    <div class="border border-[#729f9a]/25 bg-[#ffffff] p-5 shadow-[0_18px_36px_rgba(53,74,77,.14)]">
      <div class="services-menu__grid">
        {servicesMenu.map((item) => (
          <a href={item.href} class="services-menu__link no-underline">{item.label}</a>
        ))}
      </div>
      <div class="mt-4 border-t border-[#729f9a]/20 pt-4">
        <a href="/services/" class="inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.1em] text-[#354a4d] no-underline">
          View all services <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function setupServicesMenus() {
    document.querySelectorAll("[data-services-trigger]").forEach((trigger) => {
      const id = trigger.getAttribute("data-services-trigger");
      const panel = document.querySelector(`[data-services-panel="${id}"]`);
      const chevron = document.querySelector(`[data-services-chevron="${id}"]`);
      if (!panel) return;

      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        const isOpen = panel.classList.toggle("hidden") === false;
        trigger.setAttribute("aria-expanded", String(isOpen));
        chevron?.classList.toggle("rotate-180", isOpen);
      });
    });

    document.addEventListener("click", () => {
      document.querySelectorAll("[data-services-panel]").forEach((panel) => panel.classList.add("hidden"));
      document.querySelectorAll("[data-services-trigger]").forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
      document.querySelectorAll("[data-services-chevron]").forEach((chevron) => chevron.classList.remove("rotate-180"));
    });
  }

  setupServicesMenus();
</script>
