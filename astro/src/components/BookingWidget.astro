---
// Practice By Numbers online appointment booking.
//
// Their instructions put the loader in <head>, which on every page load injects a hidden iframe
// and a ~6MB booking bundle (React, Stripe, Google Maps). Instead, nothing is downloaded until a
// visitor clicks a "Book" / "Request a visit" button; the loader is fetched then and the widget
// opens as soon as it is ready. If it fails or is slow, the click falls through to /contact/.
//
// Their own floating "Book" button is hidden: the site already has Book buttons everywhere,
// plus the mobile Call/Book bar and the Cherry pill in the same corner.
const loaderSrc = "https://appcontent.practicenumbers.com/phone_number_replace_7ff6c4a0391f4e5190c125439db6ef49.js";
---

<style is:global>
  /* Practice By Numbers' own floating button; the site provides its own Book buttons. */
  .float-btn { display: none !important; }
  .is-loading-booking { cursor: progress; opacity: .7; pointer-events: none; }
</style>

<script define:vars={{ loaderSrc }}>
  (function () {
    var BOOK_TEXT = /\b(book|request a (visit|consultation)|schedule)\b/i;
    var FALLBACK_AFTER_MS = 10000;
    var loading = null;

    function loadBooking() {
      if (loading) return loading;
      loading = new Promise(function (resolve, reject) {
        var s = document.createElement("script");
        s.async = true;
        s.src = loaderSrc;
        s.onload = function () { resolve(); };
        s.onerror = function () { reject(new Error("Practice By Numbers loader failed")); };
        document.head.appendChild(s);
      });
      return loading;
    }

    function openBooking() {
      var open = window.openPracticeNumbersAppointmentBookingWidget;
      if (typeof open !== "function") return false;
      open();
      // The loader warns (instead of throwing) when the widget is inactive, so confirm it actually opened.
      var iframe = document.getElementById("pbn-oab-widget-iframe");
      return !!iframe && iframe.style.display !== "none";
    }

    function isBookLink(a) {
      if (!a || a.getAttribute("href") !== "/contact/") return false;
      return BOOK_TEXT.test((a.textContent || "").trim());
    }

    document.addEventListener("click", function (event) {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      var a = event.target.closest ? event.target.closest("a") : null;
      if (!isBookLink(a)) return;
      event.preventDefault();

      var fallback = function () { window.location.href = a.href; };
      var timer = setTimeout(fallback, FALLBACK_AFTER_MS);
      a.classList.add("is-loading-booking");
      a.setAttribute("aria-busy", "true");

      loadBooking().then(function () {
        clearTimeout(timer);
        a.classList.remove("is-loading-booking");
        a.removeAttribute("aria-busy");
        if (!openBooking()) fallback();
      }).catch(function () {
        clearTimeout(timer);
        fallback();
      });
    });

    // Warm the cache once the visitor shows intent (hover or focus on a Book button), so the
    // click feels instant for most people. Touch devices skip this and load on the tap.
    document.addEventListener("pointerover", function (event) {
      if (event.pointerType !== "mouse") return;
      var a = event.target.closest ? event.target.closest("a") : null;
      if (isBookLink(a)) loadBooking().catch(function () {});
    }, { passive: true });
  })();
</script>
