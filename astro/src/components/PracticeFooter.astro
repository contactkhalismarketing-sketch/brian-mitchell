---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { liveAssets } from "../lib/data";
---

<footer class="bg-[#fffaf3] pb-24 md:pb-0">
  <div class="mx-auto flex max-w-[1440px] flex-col justify-between gap-7 px-5 pt-10 sm:px-8 md:flex-row md:items-center lg:px-12">
    <Image src={liveAssets.logo} alt="Dr. Brian Mitchell & Associates" class="w-[210px]" width={410} />
    <div class="text-xs leading-6 text-[#4f625d]">
      <p>6383 E. Grant Road, Suite 155 · Tucson, AZ 85715</p>
      <p>Monday–Tuesday 8am–4pm · Wednesday–Friday 7am–4pm</p>
    </div>
    <div class="flex items-center gap-3 border-l-2 border-[#bb6846] pl-3">
      <Image src={liveAssets.bioclear} alt="Dr. Brian Mitchell BioClear Certified" class="h-16 w-16 object-contain" width={128} />
      <p class="max-w-[155px] text-[0.64rem] font-extrabold uppercase leading-4 tracking-[0.11em] text-[#27594e]">Dr. Brian Mitchell<br />BioClear Certified</p>
    </div>
  </div>
  <div class="mx-auto flex max-w-[1440px] flex-wrap gap-x-6 gap-y-2 px-5 py-6 sm:px-8 lg:px-12">
    <a href="/first-visit/" class="text-[.68rem] font-extrabold uppercase tracking-[.1em] text-[#52736b] no-underline hover:text-[#27594e]">Your first visit</a>
    <a href="/patient-info/financial/" class="text-[.68rem] font-extrabold uppercase tracking-[.1em] text-[#52736b] no-underline hover:text-[#27594e]">Financing & insurance</a>
  </div>
  <div class="border-t border-[#77a49f]/20">
    <div class="mx-auto flex max-w-[1440px] flex-col gap-2 px-5 py-5 text-xs leading-6 text-[#4f625d] sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
      <p>&copy; {new Date().getFullYear()} Dr. Brian Mitchell & Associates. All rights reserved.</p>
      <p>Website designed by <a href="https://khalismarketing.com.au" target="_blank" rel="noopener" class="font-bold text-[#27594e] underline underline-offset-2">Khalis Marketing</a></p>
    </div>
  </div>
</footer>
<div class="fixed inset-x-0 bottom-0 z-40 flex items-center gap-3 bg-[#fffaf3]/95 px-4 py-3 shadow-[0_-6px_30px_rgba(26,29,30,.13)] backdrop-blur md:hidden">
  <a class="action-button outline flex-1 py-3" href="tel:5205234860"><Icon name="lucide:phone" class="h-3.5 w-3.5" />Call</a>
  <a class="action-button primary flex-1 py-3" href="/contact/"><Icon name="lucide:calendar-days" class="h-3.5 w-3.5" />Book</a>
</div>
