---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  image: ImageMetadata;
  imagePosition?: string;
  imageMobile?: ImageMetadata;
  imageMobilePosition?: string;
  taller?: boolean;
}

const { eyebrow, title, body, image, imagePosition = "center", imageMobile, imageMobilePosition = "center", taller = false } = Astro.props;

const positionVars = `--hero-pos-desktop: ${imagePosition}; --hero-pos-mobile: ${imageMobile ? imageMobilePosition : imagePosition};`;
const desktop = imageMobile ? await getImage({ src: image, width: 1920, format: "webp" }) : null;
const mobile = imageMobile ? await getImage({ src: imageMobile, width: 1024, format: "webp" }) : null;
---

<section class={`page-hero relative isolate overflow-hidden bg-[#1f2b33] text-[#1f2b33] ${taller ? "taller" : ""}`}>
  <div class="page-hero__image-band relative">
    {desktop && mobile ? (
      <picture>
        <source media="(min-width: 1024px)" srcset={desktop.src} />
        <img src={mobile.src} alt="" style={positionVars} class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" />
      </picture>
    ) : (
      <Image src={image} alt="" style={positionVars} class="absolute inset-0 h-full w-full object-cover" width={1440} loading="eager" />
    )}
  </div>
  <div class="page-hero__copy-band relative">
    <div class="relative mx-auto flex max-w-[1440px] items-center px-5 sm:px-8 lg:px-12 xl:pl-20">
      <div class="page-hero__copy-panel">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="display-face mt-4 max-w-xl text-4xl leading-[.95] tracking-[-.03em] sm:text-5xl lg:text-6xl">{title}</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-[#3d7488]">{body}</p>
        <slot />
      </div>
    </div>
  </div>
</section>
