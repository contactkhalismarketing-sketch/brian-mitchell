---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  image: ImageMetadata;
  imagePosition?: string;
  taller?: boolean;
}

const { eyebrow, title, body, image, imagePosition = "center", taller = false } = Astro.props;
---

<section class={`page-hero relative isolate overflow-hidden bg-[#2b2930] text-[#2b2930] ${taller ? "taller" : ""}`}>
  <div class="page-hero__image-band relative">
    <Image src={image} alt="" style={{ objectPosition: imagePosition }} class="absolute inset-0 h-full w-full object-cover" width={1440} loading="eager" />
  </div>
  <div class="page-hero__copy-band relative">
    <div class="relative mx-auto flex max-w-[1440px] items-center px-5 sm:px-8 lg:px-12 xl:pl-20">
      <div class="page-hero__copy-panel">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="display-face mt-4 max-w-xl text-4xl leading-[.95] tracking-[-.03em] sm:text-5xl lg:text-6xl">{title}</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-[#52736b]">{body}</p>
        <slot />
      </div>
    </div>
  </div>
</section>
