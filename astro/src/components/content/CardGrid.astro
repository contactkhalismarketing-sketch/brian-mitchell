---
import { Icon } from "astro-icon/components";
// Grid of H3 cards. Body strings may contain inline links unless the card itself is a link (href).
interface Item { title: string; body: string; href?: string }
interface Props { items: Item[]; columns?: 2 | 3 }
const { items, columns = 3 } = Astro.props;
---
<div class={`content-cards ${columns === 2 ? "content-cards--2" : ""}`}>
  {items.map((item) => item.href ? (
    <a href={item.href} class="content-card content-card--link group">
      <h3 class="display-face text-2xl leading-[1.08] text-[#283e3c]">{item.title}</h3>
      <p class="mt-3 text-sm leading-7 text-[#4a5a58]">{item.body}</p>
      <span class="content-card__more">Learn more <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" /></span>
    </a>
  ) : (
    <article class="content-card">
      <h3 class="display-face text-2xl leading-[1.08] text-[#283e3c]">{item.title}</h3>
      <p class="mt-3 text-sm leading-7 text-[#4a5a58]" set:html={item.body} />
    </article>
  ))}
</div>
