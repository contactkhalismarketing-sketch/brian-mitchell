---
// H2 block used by the long-form service and home page sections.
interface Props { eyebrow?: string; title: string; intro?: string; light?: boolean }
const { eyebrow, title, intro, light = false } = Astro.props;
---
<div class="content-head">
  {eyebrow && <p class={`eyebrow ${light ? "text-[#d5e4e2]" : ""}`}>{eyebrow}</p>}
  <h2 class={`display-face mt-3 max-w-3xl text-3xl leading-[1.04] tracking-[-.02em] sm:text-4xl ${light ? "text-white" : "text-[#283e3c]"}`}>{title}</h2>
  {intro && <p class={`mt-5 max-w-3xl text-base leading-8 ${light ? "text-[#d5e4e2]" : "text-[#4a5a58]"}`} set:html={intro} />}
</div>
