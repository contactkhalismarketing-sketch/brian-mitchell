---
// Minimal list: each item is a short bold lead on its own line with the supporting text beneath,
// laid out in columns with a hairline above each item (no icons).
interface Props { items: [string, string][]; columns?: 1 | 2 | 3 }
const { items, columns = 2 } = Astro.props;
const lead = (text: string) => text.replace(/[:.]\s*$/, "");
---
<ul class={`content-leads content-leads--${columns}`}>
  {items.map(([title, text]) => (
    <li>
      <h3>{lead(title)}</h3>
      <p set:html={text.charAt(0).toUpperCase() + text.slice(1)} />
    </li>
  ))}
</ul>
