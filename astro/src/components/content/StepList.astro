---
// Numbered steps: a single row on wide screens (one column per step), stacked on phones.
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<ol class="content-steps" style={`--steps:${items.length}`}>
  {items.map(([lead, text], index) => (
    <li>
      <span class="content-steps__number">{String(index + 1).padStart(2, "0")}</span>
      <h3>{lead.replace(/\.\s*$/, "")}</h3>
      <p set:html={text} />
    </li>
  ))}
</ol>
