---
// Cherry "Pay over time" floating estimator. Slug and defaults are the practice's own,
// carried over from the current site's embed; colours/fonts match this design.
// Loaded after the page has painted so it never competes with the hero for bandwidth.
---

<div id="floatingEstimator"></div>
<script is:inline>
  (function () {
    function loadCherry() {
      (function (w, d, s, o, f, js, fjs) {
        w[o] = w[o] || function () { (w[o].q = w[o].q || []).push(arguments); };
        (js = d.createElement(s)), (fjs = d.getElementsByTagName(s)[0]);
        js.id = o; js.src = f; js.async = 1; fjs.parentNode.insertBefore(js, fjs);
      })(window, document, "script", "_hw", "https://files.withcherry.com/widgets/widget.js");
      var config = {
        debug: false,
        variables: {
          slug: "dr-brian-mitchell-dentistry-and-orthodontics",
          name: "Dr. Brian Mitchell Dentistry and Orthodontics",
          images: [21],
          customLogo: "",
          defaultPurchaseAmount: 2000,
          customImage: "",
          imageCategory: "dental",
          language: "en",
        },
        styles: {
          primaryColor: "#354a4d",
          secondaryColor: "#729f9a1a",
          fontFamily: "Manrope",
          headerFontFamily: "DM Serif Display",
          floatingEstimator: {
            position: "bottom-right",
            offset: { x: "0px", y: "0px" },
            zIndex: 40,
            ctaFontFamily: "Manrope",
            bodyFontFamily: "Manrope",
            ctaColor: "#354a4d",
            ctaTextColor: "#FFFFFF",
          },
        },
      };
      _hw("init", config, ["floatingEstimator"]);
      // Pages that include <CherryPaymentPlans /> also get the full-page widget.
      if (document.getElementById("all")) _hw("init", config, ["hero", "calculator", "howitworks", "faq"]);
    }
    // Cherry is 425KB of third-party JavaScript. It loads on the visitor's first scroll, touch,
    // mouse movement or key press (or after 8s of idle as a fallback), so it never competes with
    // the page's own loading and stays out of what speed audits measure.
    var started = false;
    function start() {
      if (started) return;
      started = true;
      ["scroll", "pointermove", "touchstart", "keydown"].forEach(function (type) { window.removeEventListener(type, start); });
      loadCherry();
    }
    ["scroll", "pointermove", "touchstart", "keydown"].forEach(function (type) { window.addEventListener(type, start, { passive: true }); });
    window.addEventListener("load", function () { setTimeout(start, 8000); }, { once: true });
  })();
</script>
